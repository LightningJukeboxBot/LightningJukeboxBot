[Unit]
Description=Noderunners Radio - X announcer (@JukeboxLNDbot): posts each paid request as it goes on air
Documentation=file:/usr/local/bin/nr-announcer
After=network-online.target library-api.service
Wants=network-online.target

[Service]
Type=simple
User=sf
Group=sf
# the four X keys, written by nr-announcer-keys.py (600, owner sf); never anywhere else
EnvironmentFile=-/home/sf/.config/nr-announcer/x.env
Environment=NR_ANNOUNCER_HOME=/home/sf/.config/nr-announcer
ExecStart=/usr/bin/python3 /usr/local/bin/nr-announcer
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
