def log(msg):
    print(time.strftime("%Y-%m-%d %H:%M:%S ") + "jukebox: " + str(msg), flush=True)


def load_nostr():
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("nr_nostr", NOSTR_PATH)
    spec = importlib.util.spec_from_loader("nr_nostr", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    for name in ("keys", "pubkey", "make_event", "schnorr_verify", "bech32_encode", "bech32_decode", "publish",
                 "load_relays", "load_announcer", "_frame", "_Reader"):
        if not hasattr(mod, name):
            raise RuntimeError("%s lacks %s" % (NOSTR_PATH, name))
    mod.ann = mod.load_announcer()
    return mod


# ---------------------------------------------------------------- the station (urllib only; no third-party module)
def api_get(path, timeout=15, **params):
    url = API + path + (("?" + urllib.parse.urlencode(params)) if params else "")
    return _api(urllib.request.Request(url, headers={"User-Agent": "nr-nostr-jukebox/1"}), timeout)


def api_post(path, form, timeout=25):
    req = urllib.request.Request(API + path, data=urllib.parse.urlencode(form).encode(),
                                 headers={"User-Agent": "nr-nostr-jukebox/1",
                                          "Content-Type": "application/x-www-form-urlencoded"})
    return _api(req, timeout)


def _api(req, timeout):
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read()
            return r.status, (json.loads(raw.decode("utf-8")) if raw else {})
    except urllib.error.HTTPError as e:
        try:
            raw = e.read()
            body = json.loads(raw.decode("utf-8")) if raw else {}
        except Exception:
            body = {}
        return e.code, body if isinstance(body, dict) else {}
    except Exception as e:
        log("station %s failed: %s" % (req.full_url.split("?")[0], str(e)[:100]))
        return 0, {}


def notify(text):
    """A line for SF, through the station's admin-notes channel (the Telegram bot relays it)."""
    try:
        data = json.dumps({"src": "nostr-jukebox", "text": text[:600]}).encode()
        req = urllib.request.Request(API + "/api/admin/note", data=data,
                                     headers={"Content-Type": "application/json", "User-Agent": "nr-nostr-jukebox/1"})
        with urllib.request.urlopen(req, timeout=8) as r:
            r.read()
        return True
    except Exception as e:
        log("could not hand the note to the station API: %s" % e)
        return False


# ---------------------------------------------------------------- websocket: open, subscribe, keep listening
def ws_open(url, timeout):
    m = re.fullmatch(r"(wss?)://([^/:\s]+)(?::(\d+))?(/\S*)?", url.strip())
    if not m:
        raise ValueError("bad relay url")
    scheme, host = m.group(1), m.group(2)
    port = int(m.group(3) or (443 if scheme == "wss" else 80))
    path = m.group(4) or "/"
    raw = socket.create_connection((host, port), timeout=timeout)
    s = ssl.create_default_context().wrap_socket(raw, server_hostname=host) if scheme == "wss" else raw
    s.settimeout(timeout)
    key = base64.b64encode(secrets.token_bytes(16)).decode()
    hosthdr = host if port == (443 if scheme == "wss" else 80) else "%s:%d" % (host, port)
    s.sendall(("GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: %s\r\n"
               "Sec-WebSocket-Version: 13\r\nUser-Agent: nr-nostr-jukebox/1\r\n\r\n" % (path, hosthdr, key)).encode())
    resp = b""
    while b"\r\n\r\n" not in resp:
        c = s.recv(4096)
        if not c:
            raise OSError("handshake: the relay closed the connection")
        resp += c
        if len(resp) > 65536:
            raise OSError("handshake: reply too long")
    head, rest = resp.split(b"\r\n\r\n", 1)
    if b" 101 " not in head.split(b"\r\n", 1)[0]:
        raise OSError("handshake refused: " + head.split(b"\r\n", 1)[0].decode("latin-1")[:80])
    accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
    if accept.encode() not in head:
        raise OSError("handshake: wrong accept key")
    try:                                                 # a dead path (NAT reset, ISP blip) must not look 'up' for 15 minutes
        raw.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
        for name, val in (("TCP_KEEPIDLE", 30), ("TCP_KEEPINTVL", 10), ("TCP_KEEPCNT", 3)):
            if hasattr(socket, name):
                raw.setsockopt(socket.IPPROTO_TCP, getattr(socket, name), val)
    except Exception:
        pass
    return s, Reader(s, rest)


class Reader:
    """nr-nostr's frame reader, with one difference: a PONG is handed up as (10, payload) so the caller can tell a quiet
    relay from a dead one. Pings are still answered here; continuation frames are joined; a close frame comes up as (8, ...)."""

    def __init__(self, sock, buf=b""):
        self.s, self.buf = sock, buf

    def take(self, n):
        while len(self.buf) < n:
            c = self.s.recv(65536)
            if not c:
                raise OSError("the relay closed the connection")
            self.buf += c
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _one(self):
        b0, b1 = self.take(2)
        fin, op, masked, n = b0 & 0x80, b0 & 0x0F, b1 & 0x80, b1 & 0x7F
        if n == 126:
            n = int.from_bytes(self.take(2), "big")
        elif n == 127:
            n = int.from_bytes(self.take(8), "big")
        if n > (1 << 20):
            raise OSError("frame too big")
        mask = self.take(4) if masked else b""
        data = self.take(n)
        if masked:
            data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        return bool(fin), op, data

    def frame(self):
        data = b""
        first = None
        while True:
            fin, op, part = self._one()
            if op == 9:
                try:
                    self.s.sendall(nn._frame(part, 10))
                except Exception:
                    pass
                continue
            if op == 10:
                return 10, part
            if op == 8:
                return 8, part
            if op in (1, 2):
                if first is not None:
                    raise OSError("a new message started while one was still open")
                first = op
            elif op == 0:
                if first is None:
                    raise OSError("a continuation frame with no message open")
            else:
                raise OSError("unknown websocket opcode %d" % op)
            data += part
            if len(data) > (1 << 20):
                raise OSError("message too big")
            if fin:
                return first, data


def _close(s):
    try:
        s.sendall(nn._frame(b"\x03\xe8", 8))
    except Exception:
        pass
    try:
        s.close()
    except Exception:
        pass


class Relay(threading.Thread):
    """One relay, one subscription, for the life of the process. Reconnects with backoff; every EVENT goes to the queue.
    No cursor is kept between connections: each REQ asks for the last EVENT_MAX_AGE_S seconds (the loop drops anything
    older anyway), so no note, however dated, can move the subscription into the future (review finding)."""

    def __init__(self, url, pk_hex, out, stop, now_fn=time.time):
        super().__init__(daemon=True, name="relay:" + url)
        self.url, self.pk, self.out, self.stop, self.now = url, pk_hex, out, stop, now_fn
        self.up = None

    def run(self):
        backoff = 5
        while not self.stop.is_set():
            s = None
            born = self.now()
            try:
                s, rd = ws_open(self.url, 12)
                s.settimeout(RELAY_IDLE_S)
                sub = "nrj" + secrets.token_hex(4)
                filt = {"kinds": [1], "#p": [self.pk], "since": int(self.now() - EVENT_MAX_AGE_S)}
                s.sendall(nn._frame(json.dumps(["REQ", sub, filt], separators=(",", ":")).encode()))
                if self.up is not True:
                    log("relay up: " + self.url)
                    self.up = True
                waiting_pong = False
                while not self.stop.is_set():
                    try:
                        op, data = rd.frame()
                    except socket.timeout:
                        if waiting_pong:
                            raise OSError("no pong within %d s" % RELAY_IDLE_S)
                        s.sendall(nn._frame(b"nr", 9))          # keep-alive ping: a pong (or any frame) must follow
                        waiting_pong = True
                        continue
                    waiting_pong = False
                    if self.now() - born > 60:
                        backoff = 5                          # a connection that lived a minute earns a fresh backoff
                    if op == 8:
                        raise OSError("relay closed: " + data[2:60].decode("utf-8", "replace"))
                    if op != 1:
                        continue
                    try:
                        msg = json.loads(data.decode("utf-8"))
                    except Exception:
                        continue
                    if not isinstance(msg, list) or not msg:
                        continue
                    if msg[0] == "EVENT" and len(msg) >= 3 and msg[1] == sub and isinstance(msg[2], dict):
                        self.out.put((self.url, msg[2]))
                    elif msg[0] == "CLOSED" and len(msg) > 1 and msg[1] == sub:
                        raise OSError("subscription closed: " + str(msg[2:3])[:80])
            except Exception as e:
                if self.up is not False:
                    log("relay down: %s (%s)" % (self.url, str(e)[:100]))
                    self.up = False
            finally:
                if s is not None:
                    _close(s)
            for _ in range(backoff):
                if self.stop.is_set():
                    break
                time.sleep(1)
            backoff = min(backoff * 2, 120)


def fetch_name(pk_hex, relays, timeout=3):
    """The requester's profile name (kind 0) from the first of two relays that answers; "" when none does. The kind-0
    event must be signed by that very pubkey (a relay's word is not taken)."""
    for u in relays[:2]:
        s = None
        try:
            s, rd = ws_open(u, timeout)
            s.settimeout(timeout)
            sub = "nrp" + secrets.token_hex(3)
            s.sendall(nn._frame(json.dumps(["REQ", sub, {"kinds": [0], "authors": [pk_hex], "limit": 1}],
                                           separators=(",", ":")).encode()))
            deadline = time.time() + timeout
            while time.time() < deadline:
                op, data = rd.frame()
                if op == 8:
                    break
                if op != 1:
                    continue
                msg = json.loads(data.decode("utf-8"))
                if not isinstance(msg, list) or not msg or msg[1:2] != [sub]:
                    continue
                if msg[0] == "EVENT" and len(msg) >= 3 and isinstance(msg[2], dict):
                    ev = msg[2]
                    if ev.get("pubkey") == pk_hex and event_ok(ev, kind=0):
                        prof = json.loads(ev.get("content") or "{}")
                        if isinstance(prof, dict):
                            return str(prof.get("display_name") or prof.get("name") or "")[:60]
                    break
                if msg[0] == "EOSE":
                    break
        except Exception:
            pass
        finally:
            if s is not None:
                _close(s)
    return ""


# ---------------------------------------------------------------- events: verify, read, mention
_HEX64 = re.compile(r"[0-9a-f]{64}")
_MENTION = re.compile(r"(?:nostr:)?(?:npub1|nprofile1|note1|nevent1|naddr1)[02-9ac-hj-np-z]{6,}", re.I)


def event_ok(ev, kind=1):
    """A well-formed event of this kind whose id and signature check out."""
    try:
        pk, eid, sig = ev["pubkey"], ev["id"], ev["sig"]
        ca, kind_, tags, content = int(ev["created_at"]), int(ev["kind"]), ev["tags"], ev["content"]
        if not (_HEX64.fullmatch(pk) and _HEX64.fullmatch(eid) and re.fullmatch(r"[0-9a-f]{128}", sig)):
            return False
        if kind_ != kind or not isinstance(tags, list) or not isinstance(content, str):
            return False
        kind = kind_
        if not all(isinstance(t, list) and all(isinstance(x, str) for x in t) for t in tags):
            return False
        ser = json.dumps([0, pk, ca, kind, tags, content], separators=(",", ":"), ensure_ascii=False).encode("utf-8")
        if hashlib.sha256(ser).hexdigest() != eid:
            return False
        return nn.schnorr_verify(bytes.fromhex(eid), bytes.fromhex(pk), bytes.fromhex(sig))
    except Exception:
        return False


def strip_mentions(text):
    return re.sub(r"\s+", " ", _MENTION.sub(" ", text or "")).strip()


def bech32_any(s):
    """bech32 without the 90-character cap: NIP-19 TLV forms (nprofile with relay hints) run longer. Returns (hrp, bytes)."""
    s = str(s or "").strip().lower()
    pos = s.rfind("1")
    if pos < 1 or pos + 7 > len(s) or len(s) > 1000:
        raise ValueError("not bech32")
    hrp, data = s[:pos], [nn._B32.find(c) for c in s[pos + 1:]]
    if -1 in data or nn._polymod(nn._hrp_expand(hrp) + data) != 1:
        raise ValueError("bad checksum")
    return hrp, bytes(nn._convertbits(data[:-6], 5, 8, False))


def mentions(text, pk_hex):
    """Does the content name this pubkey (npub, or an nprofile whose TLV carries it, relay hints or not)?"""
    for m in _MENTION.finditer(text or ""):
        tok = m.group(0).lower()
        if tok.startswith("nostr:"):
            tok = tok[6:]
        try:
            hrp, raw = bech32_any(tok)
        except Exception:
            continue
        if hrp == "npub" and raw.hex() == pk_hex:
            return True
        if hrp == "nprofile":
            i = 0
            while i + 2 <= len(raw):
                t, n = raw[i], raw[i + 1]
                if t == 0 and raw[i + 2:i + 2 + n].hex() == pk_hex:
                    return True
                i += 2 + n
    return False


def parse_cmd(text):
    t = strip_mentions(text).strip().lstrip("/").strip()
    m = re.match(r"(?is)^(play|request|add)\b[\s:,-]*(.*)$", t)
    if m:
        q = m.group(2).strip()
        return ("play", q) if q else ("help", "")
    w = t.lower().strip(" ?!.")
    if w in ("queue", "q", "what's queued", "whats queued", "what is queued"):
        return "queue", ""
    if w in ("now", "np", "nowplaying", "now playing", "what's playing", "whats playing", "what is playing"):
        return "now", ""
    if w in ("random", "shuffle"):
        return "play", "random"
    return "help", ""


def thread_tags(parent, own_pk=None):
    """NIP-10 tags for a reply to `parent`: the thread root (from the parent's own root marker, else its first e tag,
    else the parent itself), the parent as 'reply', and the people to notify: the parent's author -- or, when the
    parent is one of OUR notes (a receipt under our invoice note), the people our note tagged, never ourselves."""
    root = None
    es = [t for t in parent.get("tags", []) if len(t) >= 2 and t[0] == "e" and _HEX64.fullmatch(t[1] or "")]
    for t in es:
        if len(t) >= 4 and t[3] == "root":
            root = t[1]
    if root is None and es:
        root = es[0][1]
    tags = []
    if root and root != parent["id"]:
        tags.append(["e", root, "", "root"])
        tags.append(["e", parent["id"], "", "reply"])
    else:
        tags.append(["e", parent["id"], "", "root"])
    if own_pk and parent.get("pubkey") == own_pk:
        people = []
        for t in parent.get("tags", []):
            if len(t) >= 2 and t[0] == "p" and _HEX64.fullmatch(t[1] or "") and t[1] != own_pk and t[1] not in people:
                people.append(t[1])
    else:
        people = [parent["pubkey"]]
    for p in people[:4]:
        tags.append(["p", p])
    return tags


def fmt_dur(d):
    try:
        d = int(d or 0)
    except (TypeError, ValueError):
        d = 0
    return " · %d:%02d" % divmod(d, 60) if d > 0 else ""


