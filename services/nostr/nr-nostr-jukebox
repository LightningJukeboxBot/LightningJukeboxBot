def compose_quote(np_, rec, blocklist):
    """(content, tags) for the on-air quote note of a listener's own play note, or (None, None)."""
    artist = nn.ann.clean(np_.get("artist") or rec.get("artist") or "", 80, tracknum=True)
    title = nn.ann.clean(np_.get("title") or rec.get("title") or "", 120, tracknum=True)
    if title.casefold() == "unknown track":
        title = ""
    if not artist and not title:
        return None, None
    note = nn.ann.clean(np_.get("note") or "", 80)
    if note and blocklist and nn.ann.blocked(note, blocklist):
        log("shoutout withheld (blocklist): " + note)
        note = ""
    song = "%s \u2014 %s" % (artist, title) if artist and title else (artist or title)
    content = ONAIR_HEAD + song + ("" if song[-1:] in ".!?\u2026" else ".")
    if note:
        content += " With shoutout: \u201c%s\u201d" % note
    content += "\nnostr:" + nn.bech32_encode("note", bytes.fromhex(rec["origin"]))
    tags = [["q", rec["origin"], "", rec["origin_pk"]], ["p", rec["origin_pk"]], ["t", "noderunnersradio"], ["r", SITE]]
    return content, tags


class Jukebox:
    def __init__(self, seckey, relays, live_fn, now_fn=time.time, publisher=None, name_fn=None):
        self.sk = seckey
        self.pk = nn.pubkey(seckey).hex()
        self.npub = nn.bech32_encode("npub", bytes.fromhex(self.pk))
        self.relays = relays
        self.live_fn = live_fn
        self.now = now_fn
        self.publisher = publisher or nn.publish
        self.name_fn = name_fn or (lambda pk: fetch_name(pk, relays))
        self.lock = threading.Lock()
        self.results = {}       # our results-note id -> (rows, owner_pk, expires_at, query)
        self.open = {}          # requester pk -> (payment_hash, expires_at)
        self.last_search = {}   # requester pk -> time
        self.helped = {}        # requester pk -> time of the last help note
        self.names = {}         # requester pk -> (profile name, fetched_at)
        self.watch = []         # heap of (due, payment_hash)
        self.pending = {}       # payment_hash -> dict(parent=our invoice note, requester, started, src, artist, title)
        self.inflight = set()
        self.seen = {}          # event id -> time
        self.stamps = []        # times of our CHATTER replies (the hourly budget; money replies are never counted)
        self.chatter = {}       # requester pk -> times of chatter replies to them (the per-person budget)
        self.quiet_told = 0.0
        self.our_notes = {}     # our note id -> time (for "is this a reply to us")
        self.blocklist = nn.ann.load_blocklist()
        self.dirty = False
        self.posted = 0
        self.stale = 0          # events dropped as stale since the last log line
        self.origin = {}        # nr_nostrquote: our results-note id -> (the listener's play note id, their pubkey)
        self.onair = {}         # nr_nostrquote: payment_hash -> the queued song waiting to air (on disk)
        self.next_np = 0.0

    # ---- housekeeping
    def gc(self):
        now = self.now()
        with self.lock:
            for k in [k for k, v in self.results.items() if v[2] < now]:
                self.results.pop(k, None)
            for k in [k for k, v in self.open.items() if v[1] < now]:
                self.open.pop(k, None)
            for k in [k for k, t in self.last_search.items() if now - t > 3600]:
                self.last_search.pop(k, None)
            for k in [k for k, t in self.seen.items() if now - t > 86400]:
                self.seen.pop(k, None)
            for k in [k for k, t in self.our_notes.items() if now - t > 86400]:
                self.our_notes.pop(k, None)
            for k in [k for k, v in self.names.items() if now - v[1] > 86400]:
                self.names.pop(k, None)
            self.stamps = [t for t in self.stamps if now - t < 3600]
            for k in [k for k in self.origin if k not in self.results]:
                self.origin.pop(k, None)
            for k in [k for k, v in self.onair.items() if now - float(v.get("queued_at") or 0) > ONAIR_MAX_AGE_S]:
                self.onair.pop(k, None)
            for k in list(self.chatter):
                self.chatter[k] = [t for t in self.chatter[k] if now - t < 3600]
                if not self.chatter[k]:
                    self.chatter.pop(k, None)
            if self.stale:
                log("dropped %d stale event(s) (older than %d s, or from the future)" % (self.stale, EVENT_MAX_AGE_S))
                self.stale = 0

    def budget_left(self, pk=None):
        """Chatter budget: the station's hour, and this person's hour. Money replies never ask."""
        now = self.now()
        with self.lock:
            used = len([t for t in self.stamps if now - t < 3600])
            mine = len([t for t in self.chatter.get(pk, ()) if now - t < 3600]) if pk else 0
        return min(MAX_REPLIES_PER_HOUR - used, PERSON_REPLIES_PER_HOUR - mine)

    # ---- one reply note
    def reply(self, parent, content, kind="reply"):
        """Sign and post a NIP-10 reply. Returns the event (also in DRY, unposted), or None when it could not post.
        Chatter (lists, help, refusals) is budgeted per hour and per person; the money replies (invoice, queued, expired,
        failed) always go out -- a paid listener is never left without a word (review finding)."""
        who = parent.get("pubkey") if parent.get("pubkey") != self.pk else None
        if kind not in MONEY_KINDS:
            left = self.budget_left(who)
            if left <= 0:
                now = self.now()
                if MAX_REPLIES_PER_HOUR - len([t for t in self.stamps if now - t < 3600]) <= 0 and now - self.quiet_told > 3600:
                    self.quiet_told = now
                    log("hourly chatter budget spent (%d); quiet until the hour passes (money replies still go out)" % MAX_REPLIES_PER_HOUR)
                    notify("Nostr jukebox: %d replies in an hour -- gone quiet until the hour passes (invoices and receipts still go out)." % MAX_REPLIES_PER_HOUR)
                return None
        ev = nn.make_event(self.sk, content, thread_tags(parent, self.pk))
        with self.lock:
            self.our_notes[ev["id"]] = self.now()
        if not self.live_fn():
            log("[dry] would %s: %s" % (kind, content.replace("\n", " / ")[:160]))
            return ev
        res = self.publisher(ev, self.relays)
        ok = [u for u, good, _m in res if good]
        if not ok:
            log("%s NOT posted: %s" % (kind, "; ".join("%s: %s" % (u, m) for u, _g, m in res)[:300]))
            return None
        if kind not in MONEY_KINDS:
            with self.lock:                              # charged only for a reply that really went out
                self.stamps.append(self.now())
                if who:
                    self.chatter.setdefault(who, []).append(self.now())
        self.posted += 1
        log("%s posted to %d/%d relays: %s" % (kind, len(ok), len(res), content.replace("\n", " / ")[:120]))
        return ev

    # ---- the station
    def live_session(self):
        code, body = api_get("/api/livesplit", timeout=8)
        if code == 200 and body.get("live"):
            return body.get("dj") or "a guest DJ"
        return None

    def queue_state(self):
        code, body = api_get("/api/nowplaying", timeout=8)
        if code != 200:
            return None, set(), 0, None

        def key(t):
            if not t:
                return None
            return "%s|%s" % ((t.get("artist") or "").lower(), (t.get("title") or "").lower())
        q = body.get("queue") or []
        return key(body.get("now_playing")), {key(t) for t in q if t}, len(q), body

    # ---- incoming
    def handle(self, ev):
        now = self.now()
        if not isinstance(ev, dict) or not event_ok(ev):
            return "bad"
        if ev["pubkey"] == self.pk:
            return "own"
        ca = int(ev["created_at"])
        if ca < now - EVENT_MAX_AGE_S or ca > now + EVENT_MAX_FUTURE_S:
            with self.lock:
                self.stale += 1
            return "stale"
        with self.lock:
            if ev["id"] in self.seen:
                return "seen"
            self.seen[ev["id"]] = now
            self.dirty = True
        if not self.live_fn() and os.path.exists(OFF_FLAG):
            return "off"
        pk = ev["pubkey"]
        content = ev.get("content") or ""
        refs = [t[1] for t in ev.get("tags", []) if len(t) >= 2 and t[0] == "e"]
        with self.lock:
            rid = next((r for r in refs if r in self.results), None)
            to_us = any(r in self.our_notes for r in refs)
        if rid:
            return self.pick(ev, rid, content)
        if not (mentions(content, self.pk) or not refs or to_us):
            return "thread-noise"          # a reply in a thread that merely carries our p tag
        cmd, arg = parse_cmd(content)
        if cmd == "play":
            return self.play(ev, arg)
        if cmd == "queue":
            return self.info(ev, "queue")
        if cmd == "now":
            return self.info(ev, "now")
        with self.lock:
            last = self.helped.get(pk, 0.0)
            if now - last < HELP_GAP_S:
                return "help-quiet"
            self.helped[pk] = now
        self.reply(ev, HELP, "help")
        return "help"

    def info(self, ev, what):
        pk = ev["pubkey"]
        now = self.now()
        with self.lock:
            if now - self.last_search.get(pk, 0.0) < SEARCH_COOLDOWN_S:
                return "cooldown"
            self.last_search[pk] = now
        npk, _qk, qlen, body = self.queue_state()
        if body is None:
            self.reply(ev, "The station did not answer. Try again in a minute.", what)
            return what
        np_ = body.get("now_playing") or {}
        line = "%s — %s" % (np_.get("artist") or "?", np_.get("title") or "?") if np_ else "nothing on air"
        if what == "now":
            self.reply(ev, "On air now: %s\nListen: %s" % (line, SITE), "now")
            return "now"
        q = body.get("queue") or []
        if not q:
            self.reply(ev, "Nothing lined up. On air: %s\nMention me with: play <song>" % line, "queue")
            return "queue"
        lines = ["%d. %s — %s" % (i, t.get("artist") or "?", t.get("title") or "?") for i, t in enumerate(q[:8], 1)]
        self.reply(ev, "Lined up (%d):\n%s\nOn air: %s" % (len(q), "\n".join(lines), line), "queue")
        return "queue"

    def play(self, ev, query):
        pk = ev["pubkey"]
        now = self.now()
        query = "".join(c for c in query if c >= " ")[:MAX_QUERY_CHARS].strip()
        if not query:
            return self.handle_help(ev)
        with self.lock:
            on_cooldown = now - self.last_search.get(pk, 0.0) < SEARCH_COOLDOWN_S
            open_inv = self.open.get(pk)
        if on_cooldown:
            return "cooldown"
        with self.lock:
            self.last_search[pk] = now                   # armed before ANY answer: a refusal must not be free to repeat
        if open_inv and open_inv[1] > now:
            self.reply(ev, "You already have an invoice open. Pay that one, or let it expire, before asking for another song.", "busy")
            return "open-invoice"
        live = self.live_session()
        if live:
            self.reply(ev, "A live sesh is on — %s has the deck. The jukebox reopens when the sesh ends. %s" % (live, SITE), "sesh")
            return "live-session"
        shown = nn.ann.clean(query, MAX_QUERY_CHARS)
        if not shown or nn.ann.blocked(shown, self.blocklist):
            self.reply(ev, "Nothing aboard for that. Try an artist or a song title.", "blocked")
            return "blocked"
        rolling = query.lower() in ("random", "shuffle")
        if rolling:
            code, body = api_get("/api/sample", timeout=15, n=str(MAX_ROWS))
        else:
            code, body = api_get("/api/search", timeout=15, q=query, src="library")
        if code != 200:
            self.reply(ev, "Search is down for a moment. Try again shortly.", "down")
            return "search-down"
        results = (body.get("results") or [])[:MAX_ROWS]
        if V4V_ENABLED and not rolling and len(results) < MAX_ROWS:
            def k(t):
                return "%s|%s" % ((t.get("artist") or "").lower(), (t.get("title") or "").lower())
            have = {k(t) for t in results}
            wcode, wbody = api_get("/api/search", timeout=20, q=query, src="wavlake")
            if wcode == 200:
                extra = [t for t in (wbody.get("results") or []) if k(t) not in have]
                results = results + extra[:MAX_ROWS - len(results)]
        if not results:
            self.reply(ev, "Nothing aboard for “%s”. The station plays its own library, so not everything is here yet." % shown, "none")
            return "no-results"
        rows, lines = [], []
        for n, t in enumerate(results, 1):
            src = (t.get("source") or "library").lower()
            rows.append((t.get("artist") or "", t.get("title") or "", src, t.get("guid") or t.get("source_uri") or "",
                         int(t.get("sats") or 21)))
            tag = "V4V " if src == "wavlake" else ""
            line = "%d. %s%s — %s%s" % (n, tag, t.get("artist") or "?", t.get("title") or "?", fmt_dur(t.get("duration_s")))
            album = (t.get("album") or "").strip()
            if album:
                line += " · " + album[:24]
            lines.append(line[:190])
        head = "A hand from the ship's sampler" if rolling else "Found these for “%s”" % shown
        prices = "21 sats a song" + (", V4V songs 210 sats straight to the artist" if any(r[2] == "wavlake" for r in rows) else "")
        content = "%s — reply to this note with a number:\n%s\n%s." % (head, "\n".join(lines), prices)
        out = self.reply(ev, content, "results")
        if out is None:
            return "results-not-posted"
        with self.lock:
            self.results[out["id"]] = (rows, pk, now + ROW_TTL_S, shown)
            self.origin[out["id"]] = (ev["id"], pk)       # nr_nostrquote: the note the on-air quote will point at
        return "results"

    def handle_help(self, ev):
        pk = ev["pubkey"]
        now = self.now()
        with self.lock:
            if now - self.helped.get(pk, 0.0) < HELP_GAP_S:
                return "help-quiet"
            self.helped[pk] = now
        self.reply(ev, HELP, "help")
        return "help"

    def pick(self, ev, rid, content):
        pk = ev["pubkey"]
        now = self.now()
        with self.lock:
            rec = self.results.get(rid)
        if not rec:
            return "stale-list"
        rows, owner, exp, shown = rec
        if pk != owner:
            return "not-owner"
        m = re.fullmatch(r"\D*(\d{1,2})\D*", strip_mentions(content))
        if not m or not 1 <= int(m.group(1)) <= len(rows):
            with self.lock:
                if now - self.last_search.get(pk, 0.0) < 5:
                    return "bad-number-quiet"
                self.last_search[pk] = now
            self.reply(ev, "Reply with a number from 1 to %d." % len(rows), "number")
            return "bad-number"
        artist, title, src, guid, sats = rows[int(m.group(1)) - 1]
        with self.lock:
            open_inv = self.open.get(pk)
            tracked = len(self.watch)
        if open_inv and open_inv[1] > now:
            self.reply(ev, "You already have an invoice open. Pay that one first.", "busy")
            return "open-invoice"
        np_key, q_keys, q_len, _b = self.queue_state()
        key = "%s|%s" % (artist.lower(), title.lower())
        if key == np_key or key in q_keys:
            self.reply(ev, "%s — %s is already lined up. No sense paying twice." % (artist, title), "dup")
            return "already-queued"
        if q_len >= QUEUE_FULL_AT:
            self.reply(ev, "The deck is full right now. Try again in a bit.", "full")
            return "deck-full"
        if tracked >= MAX_TRACKED:
            self.reply(ev, "Too many open invoices right now. Try again in a few minutes.", "full")
            return "watch-full"
        if not self.live_fn():
            log("[dry] would mint: %s — %s (%s) for %s" % (artist, title, src, self.npub_short(pk)))
            with self.lock:
                self.results.pop(rid, None)
            return "dry-mint"
        with self.lock:
            cached = self.names.get(pk)
        if cached is None:
            name = nn.ann.clean(self.name_fn(pk) or "", 24)
            if name and nn.ann.blocked(name, self.blocklist):
                log("profile name withheld (blocklist) for %s" % self.npub_short(pk))
                name = ""                                # a stranger's chosen name is never echoed unchecked (review finding)
            with self.lock:
                self.names[pk] = (name, now)
        else:
            name = cached[0]
        # nr_at (2026-09-09, SF): "If a song is requested via telegram, the @ should be on telegram only,
        # not on the other channels -- and visa versa." "via" tells the station where this came from, so a
        # Nostr name never becomes a live @tag in a Telegram group, where that handle is someone else.
        form = {"artist": artist, "title": title, "who": name or self.npub_short(pk), "via": "nostr"}
        if src == "wavlake":
            if not guid:
                self.reply(ev, "That Wavlake track lost its id. Search again.", "err")
                return "no-guid"
            form["source"] = "wavlake"
            form["guid"] = guid
        code, body = api_post("/api/play", form)
        if code == 409:
            self.reply(ev, "A live sesh just started — the DJ has the deck. Nothing taken.", "sesh")
            return "live-session"
        if code == 404:
            self.reply(ev, "That one slipped off the shelf. Search again.", "err")
            return "not-found"
        if code != 200 or not body.get("bolt11"):
            self.reply(ev, "The Lightning rail did not answer. Nothing taken — try again in a minute.", "err")
            return "rail-down"
        ph = body["payment_hash"]
        sats = int(body.get("sats") or sats)
        content = ("⚡ %s — %s\nPay %d sats within 15 minutes and it joins the queue:\n\n%s\n\n"
                   "Your app shows a Pay button for this; or copy it into your wallet. I check on my own." % (artist, title, sats, body["bolt11"]))
        out = self.reply(ev, content, "invoice")
        with self.lock:
            self.results.pop(rid, None)
            self.open[pk] = (ph, now + INVOICE_TTL_S)
            self.pending[ph] = {"parent": out or ev, "requester": pk, "started": now, "src": src, "artist": artist, "title": title,
                                "origin": self.origin.pop(rid, None)}
            heapq.heappush(self.watch, (now + 3, ph))
        if out is None:
            notify("Nostr jukebox: an invoice was minted but the reply did not post (hash %s…). If it gets paid the song still queues." % ph[:12])
        return "invoice"

    def npub_short(self, pk):
        n = nn.bech32_encode("npub", bytes.fromhex(pk))
        return n[:9] + "…" + n[-4:]

    # ---- the watcher
    def check(self, ph):
        """One status call for one invoice. True when finished with it."""
        with self.lock:
            rec = self.pending.get(ph)
            if rec is None or ph in self.inflight:
                return True if rec is None else False
            self.inflight.add(ph)
        try:
            code, body = api_get("/api/play/status", timeout=STATUS_TIMEOUT, payment_hash=ph)
        finally:
            with self.lock:
                self.inflight.discard(ph)
        parent = rec["parent"]
        if code == 404:
            self.forget(ph)
            self.reply(parent, "That invoice expired. If you did pay it, tell the station and we sort it out.", "expired")
            return True
        if code == 500:
            notify("⚠️ NOSTR ZAP LANDED BUT NOT QUEUED — hash %s… requester %s. Refund or replay owed." % (ph[:16], self.npub_short(rec["requester"])))
            self.reply(parent, "Your payment landed but the track failed to queue. The station has been told and will make it right.", "failed")
            self.forget(ph)
            return True
        if code != 200:
            return False
        if body.get("queued"):
            pos = ""
            try:
                _n, _q, q_len, _b = self.queue_state()
                if q_len:
                    pos = " You are #%d in the queue." % q_len
            except Exception:
                pass
            self.reply(parent, "⚡ Paid and queued: %s — %s.%s\nListen: %s" % (rec["artist"], rec["title"], pos, SITE), "queued")
            notify(("⚡ V4V QUEUED via nostr — a stranger's upload is going on air: " if rec["src"] == "wavlake" else "queued via nostr: ")
                   + "%s - %s (%s)" % (rec["artist"], rec["title"], self.npub_short(rec["requester"])))
            if rec.get("origin"):                       # nr_nostrquote: wait for it to air, then quote the play note
                with self.lock:
                    self.onair[ph] = {"origin": rec["origin"][0], "origin_pk": rec["origin"][1], "artist": rec["artist"],
                                      "title": rec["title"], "queued_at": self.now(), "tries": 0}
                    self.dirty = True
            self.forget(ph)
            return True
        return False

    def forget(self, ph):
        with self.lock:
            rec = self.pending.pop(ph, None)
            if rec and self.open.get(rec["requester"], ("",))[0] == ph:
                self.open.pop(rec["requester"], None)

    def watcher_tick(self, max_checks=5):
        """A few due invoices per tick, re-armed from the clock AFTER each call (a slow station must not collapse the
        3/10/30 s ladder into back-to-back polling). Runs on its own thread in the service (review finding)."""
        for _ in range(max_checks):
            now = self.now()
            with self.lock:
                if not self.watch or self.watch[0][0] > now:
                    return
                due, ph = heapq.heappop(self.watch)
                rec = self.pending.get(ph)
            if rec is None:
                continue
            age = now - rec["started"]
            if age > INVOICE_TTL_S + 120:
                self.forget(ph)
                self.reply(rec["parent"], "That invoice expired. If you did pay it, tell the station and we sort it out.", "expired")
                continue
            done = False
            try:
                done = self.check(ph)
            except Exception as e:
                log("status check error: %s" % e)
            if not done:
                gap = 3 if age < 60 else (10 if age < 300 else 30)
                with self.lock:
                    if ph in self.pending:
                        heapq.heappush(self.watch, (self.now() + gap, ph))

    def watcher(self, stop):
        while not stop.is_set():
            try:
                self.watcher_tick()
                self.quote_tick()
            except Exception as e:
                log("watcher error: %s" % e)
            stop.wait(1)

    # ---- nr_nostrquote (SF 2026-09-13): the on-air quote note, the X lane's twin
    def quote_tick(self):
        """Every 15 s while a paid song waits to air: when it is NOW PLAYING, quote the listener's own play note, once."""
        now = self.now()
        with self.lock:
            waiting = bool(self.onair)
        if not waiting or now < self.next_np:
            return None
        self.next_np = now + ONAIR_POLL_S
        code, body = api_get("/api/nowplaying", timeout=8)
        if code != 200:
            return "api-down"
        np_ = (body or {}).get("now_playing") or {}
        if not np_.get("requested") or str(np_.get("note_via") or "") != "nostr":
            return "not-ours"
        key = ((np_.get("artist") or "").casefold(), (np_.get("title") or "").casefold())
        with self.lock:
            hits = sorted((float(v.get("queued_at") or 0), ph) for ph, v in self.onair.items()
                          if ((v.get("artist") or "").casefold(), (v.get("title") or "").casefold()) == key)
            if not hits:
                return "not-ours"
            ph = hits[0][1]
            rec = self.onair[ph]
        content, tags = compose_quote(np_, rec, self.blocklist)
        if not content:
            with self.lock:
                self.onair.pop(ph, None)
                self.dirty = True
            return "nothing-to-say"
        if not self.live_fn():
            log("[dry] would quote %s: %s" % (rec["origin"][:12], content.replace("\n", " / ")))
            with self.lock:
                self.onair.pop(ph, None)
                self.dirty = True
            return "dry"
        with self.lock:
            rec.setdefault("created_at", int(now))           # a retry keeps the SAME event id: relays dedupe it
        ev = nn.make_event(self.sk, content, tags, created_at=rec["created_at"])
        with self.lock:
            self.our_notes[ev["id"]] = now
        res = self.publisher(ev, self.relays)
        ok = [u for u, good, _m in res if good]
        if ok:
            with self.lock:
                self.onair.pop(ph, None)
                self.dirty = True
            self.posted += 1
            log("quoted %s -> %s on %d/%d relays: %s" % (rec["origin"][:12], ev["id"][:12], len(ok), len(res), content.splitlines()[0]))
            if "\u201c" in content:
                notify("Nostr quote %s carried a shoutout: %s" % (ev["id"][:12], content.splitlines()[0]))
            return "quoted"
        with self.lock:
            rec["tries"] = int(rec.get("tries") or 0) + 1
            gone = rec["tries"] >= 3
            if gone:
                self.onair.pop(ph, None)
            self.dirty = True
        log("quote note NOT accepted by any relay (try %d%s): %s" % (rec["tries"], ", giving up" if gone else "",
                                                                      "; ".join("%s: %s" % (u, m) for u, _g, m in res)[:200]))
        return "gave-up" if gone else "retry"

    # ---- state on disk (only what must survive a restart: the seen set and the hourly budget)
    def load_state(self):
        try:
            with open(STATE, encoding="utf-8") as fh:
                st = json.load(fh)
            now = self.now()
            with self.lock:
                self.seen = {k: float(v) for k, v in (st.get("seen") or {}).items() if now - float(v) < 86400}
                self.stamps = [float(t) for t in (st.get("stamps") or []) if now - float(t) < 3600]
                self.helped = {k: float(v) for k, v in (st.get("helped") or {}).items() if now - float(v) < HELP_GAP_S}
                self.onair = {k: v for k, v in (st.get("onair") or {}).items()
                              if isinstance(v, dict) and now - float(v.get("queued_at") or 0) < ONAIR_MAX_AGE_S}
        except Exception:
            pass

    def save_state(self):
        with self.lock:
            st = {"seen": self.seen, "stamps": self.stamps, "helped": self.helped, "onair": self.onair}
            self.dirty = False
        tmp = STATE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(st, fh)
        os.replace(tmp, STATE)


def live_mode():
    return os.path.exists(LIVE_FLAG) and not os.path.exists(OFF_FLAG)


_stop = threading.Event()


def _on_term(signum, frame):
    _stop.set()


def main():
    global nn
    args = sys.argv[1:]
    if args == ["--selftest"]:
        return selftest()
    try:
        nn = load_nostr()
    except Exception as e:
        log("STOP: cannot load %s: %s" % (NOSTR_PATH, e))
        return 3
    sk = nn.keys()
    if args == ["--check"]:
        print("home: %s\nkey: %s\nLIVE: %s  OFF: %s\nrelays: %s\nblocklist: %d entries\nmax replies/hour: %d  V4V lane: %s\nstation: %s" % (
            HOME, ("present -> " + nn.bech32_encode("npub", nn.pubkey(sk))) if sk else "MISSING",
            os.path.exists(LIVE_FLAG), os.path.exists(OFF_FLAG), ", ".join(nn.load_relays()), len(nn.ann.load_blocklist()),
            MAX_REPLIES_PER_HOUR, "on" if V4V_ENABLED else "off", API))
        code, body = api_get("/api/nowplaying", timeout=8)
        print("station answers: %s" % ("yes" if code == 200 else "NO (%s)" % code))
        return 0
    if args:
        print(__doc__)
        return 64
    if not sk:
        log("STOP: no key (HOME/nostr.env); run nr-nostr-keys.py first")
        return 2
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    try:
        import fcntl
        lk = open(os.path.join(HOME, ".jukebox.lock"), "w")
        fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        globals()["_LOCK"] = lk
    except ImportError:
        pass
    except OSError:
        log("STOP: another nr-nostr-jukebox is running (the service?).")
        return 65
    relays = nn.load_relays()
    bot = Jukebox(sk, relays, live_mode)
    bot.load_state()
    log("I am %s; %d relays; %s" % (bot.npub, len(relays),
                                    "LIVE (replying and minting)" if live_mode() else "DRY (reading only; touch %s to go live)" % LIVE_FLAG))
    signal.signal(signal.SIGTERM, _on_term)
    signal.signal(signal.SIGINT, _on_term)
    inbox = queue.Queue()
    threads = [Relay(u, bot.pk, inbox, _stop) for u in relays]
    for t in threads:
        t.start()
    threading.Thread(target=bot.watcher, args=(_stop,), daemon=True, name="watcher").start()
    last_gc = last_save = time.time()
    while not _stop.is_set():
        try:
            url, ev = inbox.get(timeout=1)
        except queue.Empty:
            url, ev = None, None
        try:
            if ev is not None:
                r = bot.handle(ev)
                if r not in ("seen", "bad", "own", "stale", "thread-noise"):
                    log("%s from %s via %s" % (r, bot.npub_short(ev.get("pubkey", "0" * 64)) if _HEX64.fullmatch(ev.get("pubkey", "")) else "?", url))
        except Exception as e:
            log("loop error: %s" % e)
        now = time.time()
        if now - last_gc > 30:
            bot.gc()
            last_gc = now
        if bot.dirty and now - last_save > 10:
            try:
                bot.save_state()
            except Exception as e:
                log("could not write the state file: %s" % e)
            last_save = now
    try:
        bot.save_state()
    except Exception:
        pass
    log("stopping (signal); state saved")
    return 0


# ---------------------------------------------------------------- self-test (offline: a fake relay + a fake station on the loopback)
def selftest():
    global nn, API, STATE, LIVE_FLAG, OFF_FLAG
    import tempfile, http.server, socketserver
    d = tempfile.mkdtemp(prefix="nr-jukebox-test-")
    STATE = os.path.join(d, "state.json")
    LIVE_FLAG = os.path.join(d, "jukebox.LIVE")
    OFF_FLAG = os.path.join(d, "jukebox.OFF")
    nn = load_nostr()
    fails = []

    def check(name, cond):
        print(("ok   " if cond else "FAIL ") + name)
        if not cond:
            fails.append(name)

    # -- the fake station
    calls = []
    st_state = {"status": {"paid": False, "queued": False}, "status_code": 200, "queue": [], "live": False}

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _j(self, code, obj):
            raw = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            qs = urllib.parse.parse_qs(u.query)
            calls.append(("GET", u.path, qs))
            if u.path == "/api/search":
                q = (qs.get("q") or [""])[0].lower()
                if (qs.get("src") or [""])[0] == "wavlake":
                    return self._j(200, {"results": [{"artist": "Ainsley Costello", "title": "Cherry Bomb", "source": "wavlake", "guid": "g-1", "sats": 210}] if "cherry" in q else []})
                if "daft" in q:
                    return self._j(200, {"results": [{"artist": "Daft Punk", "title": "One More Time", "album": "Discovery", "duration_s": 320},
                                                     {"artist": "Daft Punk", "title": "Around the World", "duration_s": 429}]})
                return self._j(200, {"results": []})
            if u.path == "/api/sample":
                return self._j(200, {"results": [{"artist": "Bonobo", "title": "Kiara"}]})
            if u.path == "/api/livesplit":
                return self._j(200, {"live": st_state["live"], "dj": "DJ Test"})
            if u.path == "/api/nowplaying":
                return self._j(200, {"now_playing": st_state.get("np") or {"artist": "Nero", "title": "Promises"}, "queue": st_state["queue"]})
            if u.path == "/api/play/status":
                if st_state["status_code"] != 200:
                    return self._j(st_state["status_code"], {"error": "x"})
                return self._j(200, st_state["status"])
            return self._j(404, {"error": "nf"})

        def do_POST(self):
            n = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(n).decode()
            u = urllib.parse.urlparse(self.path)
            if u.path == "/api/admin/note":
                calls.append(("NOTE", u.path, json.loads(raw)))
                return self._j(200, {"ok": True})
            form = urllib.parse.parse_qs(raw)
            calls.append(("POST", u.path, form))
            if u.path == "/api/play":
                if st_state["live"]:
                    return self._j(409, {"error": "sesh"})
                sats = 210 if (form.get("source") or [""])[0] == "wavlake" else 21
                return self._j(200, {"payment_hash": "ab" * 32, "bolt11": "lnbc210n1testinvoice" + "q" * 200, "sats": sats})
            return self._j(404, {})

    srv = socketserver.ThreadingTCPServer(("127.0.0.1", 0), H)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    API = "http://127.0.0.1:%d" % srv.server_address[1]

    # -- keys and people
    bot_sk = secrets.token_bytes(32)
    alice_sk = secrets.token_bytes(32)
    bob_sk = secrets.token_bytes(32)
    carol_sk = secrets.token_bytes(32)
    bot_pk = nn.pubkey(bot_sk).hex()
    bot_npub = nn.bech32_encode("npub", bytes.fromhex(bot_pk))
    posted = []

    def fake_publish(ev, relays):
        posted.append(ev)
        return [(u, True, "") for u in relays]

    live = {"on": True}
    now = {"t": 1_800_000_000.0}
    bot = Jukebox(bot_sk, ["ws://127.0.0.1:1"], lambda: live["on"], now_fn=lambda: now["t"], publisher=fake_publish, name_fn=lambda pk: "Alice")

    def note(sk, content, tags=None, when=None):
        return nn.make_event(sk, content, tags or [["p", bot_pk]], created_at=int(when if when is not None else now["t"]))

    def reply_to(sk, parent, content):
        return note(sk, content, thread_tags(parent))

