    b2 = Jukebox(bot_sk, [], lambda: True, now_fn=lambda: now["t"], publisher=fake_publish)
    b2.load_state()
    check("the seen set survives a restart", e1["id"] in b2.seen)
    check("quote: a song waiting to air survives a restart", ("ab" * 31 + "cd") in b2.onair)
    # 16 a real websocket subscription against a fake relay on the loopback
    srv2 = socket.socket()
    srv2.bind(("127.0.0.1", 0))
    srv2.listen(2)
    port = srv2.getsockname()[1]
    got = queue.Queue()
    stop = threading.Event()
    scripted = note(alice_sk, "nostr:" + bot_npub + " play daft", when=now["t"])

    def sframe(payload, op=1):
        n = len(payload)
        head = bytes([0x80 | op]) + (bytes([n]) if n < 126 else bytes([126]) + n.to_bytes(2, "big"))
        return head + payload

    def serve():
        c, _a = srv2.accept()
        c.settimeout(10)
        buf = b""
        while b"\r\n\r\n" not in buf:
            buf += c.recv(4096)
        head = buf.split(b"\r\n\r\n", 1)[0].decode("latin-1")
        key = re.search(r"Sec-WebSocket-Key: (\S+)", head).group(1)
        acc = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        c.sendall(("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: %s\r\n\r\n" % acc).encode())
        rd = nn._Reader(c, buf.split(b"\r\n\r\n", 1)[1])
        op, data = rd.frame()
        msg = json.loads(data.decode())
        if msg[0] == "REQ" and msg[2].get("#p") == [bot_pk]:
            c.sendall(sframe(json.dumps(["EVENT", msg[1], scripted]).encode()))
            c.sendall(sframe(json.dumps(["EOSE", msg[1]]).encode()))
        time.sleep(1.5)
        c.close()

    threading.Thread(target=serve, daemon=True).start()
    rt = Relay("ws://127.0.0.1:%d" % port, bot_pk, got, stop)
    rt.start()
    try:
        url, ev = got.get(timeout=8)
        check("the subscription delivers the relay's event", ev["id"] == scripted["id"] and url.endswith(str(port)))
    except queue.Empty:
        check("the subscription delivers the relay's event", False)
    stop.set()
    srv.shutdown()
    print("\nSELFTEST %s (%d failed)" % ("PASSED" if not fails else "FAILED", len(fails)))
    return 0 if not fails else 1


