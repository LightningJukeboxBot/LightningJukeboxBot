    def check(name, cond):
        print(("PASS " if cond else "FAIL ") + name)
        if not cond:
            fails.append(name)

    # BIP-340 vectors (bitcoin/bips bip-0340/test-vectors.csv), from the file next to this program or an env path
    here = os.path.dirname(os.path.abspath(__file__))
    vec = os.environ.get("NR_BIP340_VECTORS") or next((p for p in (os.path.join(here, "bip340-test-vectors.csv"),
                                                                    "/usr/local/share/nr-nostr/bip340-test-vectors.csv") if os.path.exists(p)), "")
    if vec:
        n_sign = n_ver = 0
        with open(vec, encoding="utf-8") as fh:
            for row in csv.DictReader(fh):
                pk, msg, sig = bytes.fromhex(row["public key"]), bytes.fromhex(row["message"]), bytes.fromhex(row["signature"])
                want = row["verification result"].strip().upper() == "TRUE"
                ok = schnorr_verify(msg, pk, sig) == want
                n_ver += ok
                if not ok:
                    check("BIP-340 verify vector %s (%s)" % (row["index"], row["comment"][:40]), False)
                if row["secret key"]:
                    sk, aux = bytes.fromhex(row["secret key"]), bytes.fromhex(row["aux_rand"])
                    got = pubkey(sk) == pk and schnorr_sign(msg, sk, aux) == sig
                    n_sign += got
                    if not got:
                        check("BIP-340 sign vector %s" % row["index"], False)
        check("BIP-340: all vectors verify as expected (%d of 19) and every signing vector reproduces (%d of 8)" % (n_ver, n_sign), n_ver == 19 and n_sign == 8)
    else:
        check("BIP-340 vectors file present", False)
    sk = bytes.fromhex("B7E151628AED2A6ABF7158809CF4F3C762E7160F38B4DA56A784D9045190CFEF")
    pk = pubkey(sk)
    check("pubkey of vector 1", pk.hex().upper() == "DFF1D77F2A671C5F36183726DB2341BE58FEAE1DA2DECED843240F7B502BA659")
    sig = schnorr_sign(b"\x01" * 32, sk, secrets.token_bytes(32))
    check("sign/verify round trip; a flipped byte fails", schnorr_verify(b"\x01" * 32, pk, sig) and not schnorr_verify(b"\x02" * 32, pk, sig))
    # bech32
    npub = "npub1xkpztf7z7q7p5rcfdu2lt3yv6zqw3cegk9pcnkcp29kjy6pcx5hss0whm0"
    hrp, raw = bech32_decode(npub)
    check("npub decodes to 32 bytes and re-encodes to itself", hrp == "npub" and len(raw) == 32 and bech32_encode("npub", raw) == npub)
    nsec = bech32_encode("nsec", sk)
    check("nsec round trip", nsec.startswith("nsec1") and parse_secret(nsec) == sk and parse_secret(sk.hex()) == sk)
    bad = False
    try:
        bech32_decode(npub[:-1] + ("q" if npub[-1] != "q" else "p"))
    except ValueError:
        bad = True
    check("a wrong checksum is refused", bad)
    check("garbage is not a key", all(_raises(parse_secret, x) for x in ("", "hello", "npub1" + npub[5:], "0" * 63)))
    # event
    ev = make_event(sk, "hi", [["t", "x"]], created_at=1700000000, aux=b"\x00" * 32)
    ser = json.dumps([0, ev["pubkey"], 1700000000, 1, [["t", "x"]], "hi"], separators=(",", ":"), ensure_ascii=False)
    check("event id is the sha256 of the NIP-01 serialization", ev["id"] == hashlib.sha256(ser.encode()).hexdigest())
    check("event signature verifies for the event id", schnorr_verify(bytes.fromhex(ev["id"]), bytes.fromhex(ev["pubkey"]), bytes.fromhex(ev["sig"])))
    ev2 = make_event(sk, "café “quotes” \\ \" \n tab\t", [], created_at=1700000000, aux=b"\x00" * 32)
