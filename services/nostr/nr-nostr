        [0, ev2["pubkey"], 1700000000, 1, [], ev2["content"]], separators=(",", ":"), ensure_ascii=False).encode("utf-8")).hexdigest())
    # WebSocket framing against a fake relay
    got = {}

    def fake_relay(srv, behave):
        conn, _ = srv.accept()
        conn.settimeout(5)
        req = b""
        while b"\r\n\r\n" not in req:
            req += conn.recv(4096)
        key = re.search(rb"Sec-WebSocket-Key: (\S+)", req).group(1).decode()
        acc = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
        conn.sendall(("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: %s\r\n\r\n" % acc).encode())
        rd = _Reader(conn)
        op, data = rd.frame()
        got["op"], got["data"] = op, data
        msg = json.loads(data.decode("utf-8"))
        eid = msg[1]["id"]

        def send(obj):
            payload = json.dumps(obj).encode()
            conn.sendall(bytes([0x81]) + (bytes([len(payload)]) if len(payload) < 126 else bytes([126]) + struct.pack(">H", len(payload))) + payload)
        if behave == "ok":
            conn.sendall(bytes([0x89, 2]) + b"hi")          # a ping first; the client must pong and keep waiting
            send(["NOTICE", "welcome"])
            send(["OK", eid, True, ""])
        elif behave == "refuse":
            send(["OK", eid, False, "blocked: rate limit"])
        elif behave == "silent":
            time.sleep(3)
        try:
            rd.frame()                                       # the client's close frame
