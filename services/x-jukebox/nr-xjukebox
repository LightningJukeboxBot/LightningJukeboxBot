    check("price at 40,000 with unpaid 2 -> 180", compute_price(p, 40000, 2) == 180)
    check("price at 120,000 with unpaid 2 -> under 100, clamped to 100", compute_price(p, 120000, 2) == 100)
    check("price clamps at 500", compute_price(p, 5000, 9) == 500)
    # 5 the ledger
    L = Ledger(P("ledger.tsv"))
    t0 = {"t": 1_800_000_000.0}
    CLOCK = lambda: t0["t"]
    L.append("seed", 5.0, 0, "seed-usd=5.00")
    L.append("read", -0.025, 0, "poll")
    L.append("read_adjust", 0.015, 0, "poll:2")
    L2 = Ledger(P("ledger.tsv"))
    check("the float is replayed from the file", L2.float() == 4.99 and len(L2.rows) == 3)
    check("spend today counts the spend kinds net of the correction", abs(L2.spend(day_start(t0["t"])) - 0.010) < 1e-9)
    with open(P("ledger.tsv"), "a") as fh:
        fh.write("garbage line\n")
    L3 = Ledger(P("ledger.tsv"))
    check("a damaged line is skipped and counted", L3.bad == 1 and L3.float() == 4.99)
    os.remove(P("ledger.tsv"))
    # 6 the bot with fakes
    xlog, notes, station, posted = [], [], {"live": False, "down": False, "codes": {}, "np": {"now_playing": None, "queue": []}, "next": 1}, []
    xmode = {"mentions": None, "tweets": None, "date_skew": 0.0}
    inbox = []

    def fx(method, path, params=None, body=None):
        xlog.append((method, path, params, body))
        hdrs = {"date": email.utils.formatdate(t0["t"] + xmode["date_skew"], usegmt=True)}
        if path == "/2/users/me":
            if xmode.get("me"):
                c, b, h = xmode["me"]
                return c, hdrs, b
            return 200, hdrs, json.dumps({"data": {"id": "42", "username": "JukeboxLNDbot"}})
        if path.endswith("/mentions"):
            if xmode["mentions"]:
                c, b, h = xmode["mentions"]
                hdrs.update(h or {})
                return c, hdrs, b
            since = int(params["since_id"])
            got = sorted([p_ for p_ in inbox if int(p_["id"]) > since], key=lambda p_: -int(p_["id"]))[:int(params["max_results"])]
            return 200, hdrs, json.dumps({"data": got, "meta": {"result_count": len(got), "newest_id": got[0]["id"] if got else None}} if got else {"meta": {"result_count": 0}})
        if path == "/2/tweets":
            if xmode["tweets"]:
                c, b, h = xmode["tweets"]
                hdrs.update(h or {})
                return c, hdrs, b
            posted.append(body)
            return 201, hdrs, json.dumps({"data": {"id": "9%03d" % len(posted), "text": body["text"]}})
        if path == "/2/usage/credits":
            if xmode.get("credits"):
                c, b = xmode["credits"].pop(0)
                return c, hdrs, json.dumps(b)
            return 404, hdrs, "{}"
        return 500, hdrs, "?"

    def fget(path, timeout=8, **q):
        if station["down"]:
            return 0, {}
        if path == "/api/x/code":
            c = station["codes"].get(q.get("c"))
            if not c:
                return 404, {"error": "expired"}
            out = {"q": c["q"], "sats": c["sats"], "wl_sats": c["sats"] + 210, "status": c["status"], "expires_in": 800}
            if c["status"] == "minted":
                out.update({"artist": c["artist"], "title": c["title"]})
            return 200, out
        if path == "/api/nowplaying":
            return 200, station["np"]
        return 404, {}

    def fpost(path, form, timeout=15):
        if station["down"]:
            return 0, {}
        if path == "/api/x/code":
            if not form.get("q"):
                return 400, {"error": "missing q"}
            if int(form["sats"]) < 21:
                return 400, {"error": "sats out of range (floor 21)"}
            if station["live"]:
                return 409, {"error": "A live sesh is on -- the DJ has the deck. The jukebox reopens when the sesh ends."}
            code = "code%04d" % station["next"]
            station["next"] += 1
            station["codes"][code] = {"q": form["q"], "sats": int(form["sats"]), "note": form.get("note", ""), "status": "open"}
            return 200, {"code": code, "sats": int(form["sats"]), "wl_sats": int(form["sats"]) + 210, "expires_in": 900, "url": SITE + "/?jukebox&p=" + code}
        return 404, {}

    rates = {"a": 77130.0, "b": 77000.0}

    def ffetch(url, timeout=8):
        if url == RATE_A:
            if rates["a"] is None:
                raise OSError("down")
            return {"data": {"base": "BTC", "currency": "USD", "amount": "%.2f" % rates["a"]}}
        if rates["b"] is None:
            raise OSError("down")
        return {"error": [], "result": {"XXBTZUSD": {"a": ["1"], "c": ["%.1f" % rates["b"], "0.1"]}}}

    def mk(author, text, secs_ago=5, friends=(), rt=None, note_tweet=None, edited=False, bot=True, lead=(), reply_settings=None):
        pid = str(snowflake(t0["t"]) + len(inbox))
        ments = ([{"start": 0, "end": 14, "username": "JukeboxLNDbot", "id": "42"}] if bot else []) + [{"start": 900, "end": 905, "username": "f%s" % f, "id": f} for f in friends]
        ments += [{"start": 0, "end": 5, "username": "t%s" % f, "id": f} for f in lead]          # names X put in front (a thread)
        post = {"id": pid, "author_id": author, "text": text, "created_at": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(t0["t"] - secs_ago)),
                "entities": {"mentions": ments}, "edit_history_tweet_ids": [str(int(pid) - 7) if edited else pid]}
        if reply_settings:
            post["reply_settings"] = reply_settings
        if rt:
            post["referenced_tweets"] = [{"type": rt, "id": "1"}]
        if note_tweet:
            post["note_tweet"] = {"text": note_tweet}
        inbox.append(post)
        return post

    def run():
        r = bot.cycle()
        inbox.clear()
        return r

    write_text("budget-usd-per-day", "0.50\n")
    write_text("console-cap-usd", "60\n")
    bot = Bot(xcall=fx, getter=fget, poster=fpost, notifier=lambda s: notes.append(s), fetcher=ffetch)
    check("no seed: the purse is empty and the lane is quiet, SF told once", bot.cycle() == "purse" and any("purse is empty" in n for n in notes) and not xlog)
    write_text("seed-usd", "5.00\n")
    r = bot.cycle()
    check("the seed is booked once, users/me read once and booked, since_id = now", bot.ledger.rows[0][1] == "seed" and bot.ledger.rows[0][2] == 5.0
          and bot.ledger.rows[1][1:3] == ("read", -0.010) and bot.st["user_id"] == "42" and bot.st["since_id"] == str(snowflake(t0["t"])))
    check("an empty poll costs nothing (booked 5 reads, corrected to 0)", r == "empty" and bot.ledger.rows[-2][1:3] == ("read", -0.025) and bot.ledger.rows[-1][1:3] == ("read_adjust", 0.025) and abs(bot.ledger.float() - 4.99) < 1e-9)
    n0 = len(bot.ledger.rows)
    bot.cycle()
    check("the seed is not booked again", len(bot.ledger.rows) == n0 + 2 and bot.ledger.count(("seed", "topup"), 0) == 1)
    write_text("seed-usd", "7.00\n")
    bot.cycle()
    check("a change of seed-usd is booked once as a topup", bot.ledger.count(("topup",), 0) == 1 and bot.ledger.last(("topup",))[2] == 2.0)
