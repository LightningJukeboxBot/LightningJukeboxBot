    np_s = len(posted)
    mk("A13", "@JukeboxLNDbot stop")
    mk("A13", "@JukeboxLNDbot play x")
    r = run()
    check("stop opts the person out, for good", "optout" in r and r.endswith("optedout") and "A13" in (read_text("optout.txt") or "").split() and len(posted) == np_s)
    t0["t"] += 60
    mk("A14", "@JukeboxLNDbot play Don't Stop Me Now")
    r = run()
    lc = list(station["codes"])[-1]
    check("Don't Stop Me Now is a request", r.endswith("replied") and lc in posted[-1]["text"] and station["codes"][lc]["q"] == "Don't Stop Me Now")
