    # 1 the signer: the X docs' worked example (query + form parameters in the base string)
    h = oauth_header("POST", "https://api.twitter.com/1.1/statuses/update.json", "xvz1evFS4wEEPTGEFPHBog", "kAcSOqF21Fu85e7zjz7ZN2U4ZRhfV3WpwPAoE3Z7kBw",
                     "370773112-GmHxMAgYyLbNEtIKZeRNFsMKPR9EyMZeS9weJAEb", "LswwdoUaIvS8ltyTt5jkRh4J50vUPVVHtR2YPi5kE",
                     params={"include_entities": "true", "status": "Hello Ladies + Gentlemen, a signed OAuth request!"},
                     nonce="kYjzVBB8Y0ZFabxSWbWovY3uYSQ2pTgmZeNu2VS4cg", ts=1318622958)
    check("signer known answer (X docs): query + body params signed", 'oauth_signature="hCtSmYh%2BiHYCEqBWrE7C7hYmtUk%3D"' in h)
    h2 = oauth_header("POST", "https://api.twitter.com/1.1/statuses/update.json", "xvz1evFS4wEEPTGEFPHBog", "kAcSOqF21Fu85e7zjz7ZN2U4ZRhfV3WpwPAoE3Z7kBw",
                      "370773112-GmHxMAgYyLbNEtIKZeRNFsMKPR9EyMZeS9weJAEb", "LswwdoUaIvS8ltyTt5jkRh4J50vUPVVHtR2YPi5kE",
                      params=None, nonce="kYjzVBB8Y0ZFabxSWbWovY3uYSQ2pTgmZeNu2VS4cg", ts=1318622958)
    check("signer: leaving the query out changes the signature (the announcer's bug)", "hCtSmYh" not in h2)
    base = oauth_base("GET", "https://api.x.com/2/users/1/mentions", {"since_id": "5", "tweet.fields": "a,b", "oauth_version": "1.0"})
    check("base string: sorted, twice-encoded parameters", base == "GET&https%3A%2F%2Fapi.x.com%2F2%2Fusers%2F1%2Fmentions&oauth_version%3D1.0%26since_id%3D5%26tweet.fields%3Da%252Cb")
    # 2 xlen / weighted
    check("xlen: emoji weighs 2, ascii 1", xlen("🎧a") == 3 and xlen("abc") == 3)
    check("weighted: a link weighs 23", weighted("see https://noderunnersradio.com/?jukebox&p=abcdefgh now") == 4 + 23 + 4)
    check("weighted: a bare domain weighs 23", weighted("go noderunnersradio.com") == 3 + 23)
    t = compose_reply("https://noderunnersradio.com/?jukebox&p=k7q2m3xz", 500, 710)
    check("the reply fits 280 weighted at the top price and carries nothing but the url that autolinks", weighted(t) <= 280 and t.count("http") == 1 and "@" not in t and "#" not in t)
    check("the reply wording is final", t.startswith("Pick your song and zap: https://noderunnersradio.com/?jukebox&p=k7q2m3xz\n500 sats · a Wavlake song 710 sats · good for 15 minutes · cheaper on the site itself"))
    check("the no-match link prefills the search", compose_nomatch("dire straits") == NOMATCH.format(url="https://noderunnersradio.com/?jukebox&q=dire%20straits"))
    check("the live-sesh words", compose_sesh("DJ Ann") == "A live sesh is on — DJ Ann has the deck. The jukebox reopens when the sesh ends. noderunnersradio.com" and "the crew" in compose_sesh(""))
    # 3 parsing
    check("parse: play a | b", parse_play("@JukeboxLNDbot play dire straits | thanks Marco") == ("play", "dire straits", "thanks Marco"))
    check("parse: @bot play (no query)", parse_play("@JukeboxLNDbot play") == ("play", "", ""))
    check("parse: PLAY is case-insensitive", parse_play("@JukeboxLNDbot PLAY Nero") == ("play", "Nero", ""))
    check("parse: several leading names are stripped", parse_play("@a @JukeboxLNDbot @b play x") == ("play", "x", ""))
    check("parse: not a request when play is not first", parse_play("@JukeboxLNDbot hey play x") is None and parse_play("@JukeboxLNDbot playground") is None)
    check("parse: html entities are unescaped", parse_play("@JukeboxLNDbot play Tom &amp; Jerry") == ("play", "Tom & Jerry", ""))
    check("opt-out: stop", is_optout("@JukeboxLNDbot stop") and is_optout("@JukeboxLNDbot please STOP it") and not is_optout("@JukeboxLNDbot stopwatch"))
    check("opt-out: Don't Stop Me Now is a request", not is_optout("@JukeboxLNDbot play Don't Stop Me Now") and parse_play("@JukeboxLNDbot play Don't Stop Me Now")[1] == "Don't Stop Me Now")
    check("snowflake of a known moment", snowflake(1288834974.657 + 1) == (1000 << 22))
    check("created_at parses", parse_created("2026-09-12T10:00:00.000Z") == calendar.timegm((2026, 9, 12, 10, 0, 0)))
    # 4 the price formula (charter section 2)
    p = prices()
    check("prices: floors when there is no file", p["read"] == 0.005 and p["reply"] == 0.010 and p["post"] == 0.015 and p["margin"] == 1.5)
