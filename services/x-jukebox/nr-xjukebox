    check("the same person in the same sesh: silence", r.endswith("sesh-quiet") and len(posted) == n0)
    station["live"] = False
    t0["t"] += 60
    mk("A18", "@JukeboxLNDbot play nero third")
    r = run()
    check("after the sesh the person is served (a code) and the sesh episode closes", r.endswith("replied") and "?jukebox&p=" in posted[-1]["text"] and not bot.st["sesh_since"])
    # station down / no match
