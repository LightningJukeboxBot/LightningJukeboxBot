    check("practice: would-reply logged, nothing posted, no code minted", r.endswith("would-reply") and not posted and not station["codes"] and bot.st["would"][-1]["q"] == "dire straits" and bot.st["would"][-1]["note"] == "thanks Marco")
    check("read_adjust after a poll of 1 post booked as 5", bot.ledger.rows[-1][1:3] == ("read_adjust", 0.020) and bot.ledger.rows[-1][4] == "poll:1")
    check("since_id moves to the newest post", bot.st["since_id"] == p0["id"])
    open(P("LIVE"), "w").close()
