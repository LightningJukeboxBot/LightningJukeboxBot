    r = run()
    check("older than 300 s, not starting with play, play alone, not summoned: ignored", all(w in r for w in ("old", "not-for-bot", "no-query", "not-summoned")) and len(posted) == 3 and bot.today()["old"] == 1)
    xmode["date_skew"] = 100.0
