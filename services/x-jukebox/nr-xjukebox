    check("the POST body replies to the post and excludes the friend", posted[0]["reply"]["in_reply_to_tweet_id"] == p1["id"] and posted[0]["reply"]["exclude_reply_user_ids"] == ["77"])
    check("the message went to the station in note=, never echoed", station["codes"]["code0001"]["note"] == "for Marco" and "Marco" not in posted[0]["text"])
    rows = [r_ for r_ in bot.ledger.rows if r_[1] == "reply"]
    check("the reply is booked before the POST", rows and rows[-1][4] == "code:code0001" and rows[-1][2] == -0.010)
    check("the code is remembered as open with its sats", bot.codes["code0001"]["status"] == "open" and bot.codes["code0001"]["sats"] == 100 and bot.codes["code0001"]["author"] == "A2")
    check("in-flight is cleared after 'sent'", not bot.st["inflight"])
    # seen twice: one reply
