    r = run()
    check("names X put in front (a thread) are not friends, but everyone is kept out of the reply", r.endswith("replied") and sorted(posted[-1]["reply"]["exclude_reply_user_ids"]) == ["501", "502", "77"])
    t0["t"] += 60
    mk("A12d", "@JukeboxLNDbot play x", reply_settings="following")
    nm = len(station["codes"])
    r = run()
    check("reply_settings not everyone/mentionedUsers: skipped in silence before any mint or count", r.endswith("reply-restricted") and len(station["codes"]) == nm and int(bot.author("A12d").get("n") or 0) == 0)
    t0["t"] += 60
    mk("A12e", "@JukeboxLNDbot play x", reply_settings="mentionedUsers")
    r = run()
    check("reply_settings mentionedUsers is answered", r.endswith("replied"))
    t0["t"] += 60
    mk("A12f", "please stop", rt="retweeted")
    r = run()
    check("a retweet is gated before the opt-out check", r.endswith("retweet") and "A12f" not in (read_text("optout.txt") or ""))
    # opt-out
