    np0 = len(posted)
    r = run()
    check("a stop signal only raises the flag; the cycle in hand still completes", _stop and r.endswith("replied") and len(posted) == np0 + 1 and not bot.st["inflight"])
    print("RESULT: %d failed of %d" % (len(fails), total[0]))
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main() or 0)
