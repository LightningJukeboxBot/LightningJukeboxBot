def write_text(name, body):
    tmp = P(name) + ".new"
    with open(tmp, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(body)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, P(name))


def load_json(name, default):
    try:
        with open(P(name), encoding="utf-8") as fh:
            v = json.load(fh)
        return v if isinstance(v, type(default)) else default
    except Exception:
        return default


def save_json(name, obj):
    write_text(name, json.dumps(obj, sort_keys=True))


def prices():
    """The price table as booked: the file may raise a price, never lower it below its floor."""
    p = dict(FLOORS)
    f = load_json("prices.json", {})
    for k, floor in FLOORS.items():
        try:
            v = float(f.get(k, floor))
        except (TypeError, ValueError):
            v = floor
        p[k] = max(floor, v)
    p["read_owned"] = min(p["read_owned"], p["read"])
    return p


def take_lock(path):
    """One instance only: flock on Linux, a byte lock on Windows (the PC harness). Raises OSError when held."""
    fh = open(path, "a+")
    try:
        try:
            import fcntl
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except ImportError:
            import msvcrt
            fh.seek(0)
            msvcrt.locking(fh.fileno(), msvcrt.LK_NBLCK, 1)
    except OSError:
        fh.close()
        raise
    return fh


# ---------------------------------------------------------------- the ledger (the book): append-only, fsync'd, replayed
class Ledger:
    def __init__(self, path):
        self.path = path
        self.rows = []
        self.bad = 0
        self.load()

    def load(self):
        self.rows, self.bad = [], 0
        try:
            with open(self.path, encoding="utf-8") as fh:
                for line in fh:
                    line = line.rstrip("\n")
                    if not line or line.startswith("#"):
                        continue
                    f = line.split("\t")
                    try:
                        ts = calendar.timegm(time.strptime(f[0], "%Y-%m-%dT%H:%M:%SZ"))
                        self.rows.append((ts, f[1], float(f[2]), int(f[3]), f[4] if len(f) > 4 else ""))
                    except Exception:
                        self.bad += 1
        except OSError:
            pass

    def append(self, kind, usd, sats, ref):
        """Written and fsync'd BEFORE the call it books. Raises when it cannot be written: then the call is not made."""
        ts = CLOCK()
        ref = str(ref).replace("\t", " ").replace("\n", " ")
        line = "%s\t%s\t%.6f\t%d\t%s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts)), kind, usd, int(sats), ref)
        with open(self.path, "a", encoding="utf-8", newline="\n") as fh:
            fh.write(line)
            fh.flush()
            os.fsync(fh.fileno())
        self.rows.append((int(ts), kind, round(float(usd), 6), int(sats), ref))

    def float(self):
        return round(sum(r[2] for r in self.rows), 6)

    def spend(self, since):
        return round(-sum(r[2] for r in self.rows if r[0] >= since and r[1] in SPEND_KINDS), 6)

    def count(self, kinds, since, ref_prefix=""):
        return sum(1 for r in self.rows if r[0] >= since and r[1] in kinds and r[4].startswith(ref_prefix))

    def last(self, kinds):
        for r in reversed(self.rows):
            if r[1] in kinds:
                return r
        return None


# ---------------------------------------------------------------- station + X transport (urllib only)
def api_get(path, timeout=8, **params):
    url = API + path + (("?" + urllib.parse.urlencode(params)) if params else "")
    return _api(urllib.request.Request(url, headers={"User-Agent": "nr-xjukebox/1"}), timeout)


def api_post(path, form, timeout=15):
    req = urllib.request.Request(API + path, data=urllib.parse.urlencode(form).encode(),
                                 headers={"User-Agent": "nr-xjukebox/1", "Content-Type": "application/x-www-form-urlencoded"})
    return _api(req, timeout)


def _api(req, timeout):
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read()
            body = json.loads(raw.decode("utf-8")) if raw else {}
            return r.status, body if isinstance(body, dict) else {}
    except urllib.error.HTTPError as e:
        try:
            raw = e.read()
            body = json.loads(raw.decode("utf-8")) if raw else {}
        except Exception:
            body = {}
        return e.code, body if isinstance(body, dict) else {}
    except Exception as e:
        return 0, {"error": str(e)[:100]}


def notify(text, group=False):
    """One line to SF's Telegram through the station API's localhost admin-notes channel (the bot relays, max 3/min)."""
    try:
        data = json.dumps({"src": "x-jukebox", "text": text[:600], "group": bool(group)}).encode()
        req = urllib.request.Request(API + "/api/admin/note", data=data, headers={"Content-Type": "application/json", "User-Agent": "nr-xjukebox/1"})
        with urllib.request.urlopen(req, timeout=8) as r:
            r.read()
        return True
    except Exception as e:
        log("could not hand the note to the station API: %s" % e)
        return False


def fetch_json(url, timeout=8):
    req = urllib.request.Request(url, headers={"User-Agent": "nr-xjukebox/1"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode("utf-8"))


def x_call(method, path, params=None, body=None, timeout=20):
    """One signed call to X. Returns (status, headers-lowercased, body-text); status 0 = network trouble."""
    k = keys()
    if not k:
        return 0, {}, "no keys"
    url = X_API + path
    full = url + (("?" + urllib.parse.urlencode(params, quote_via=urllib.parse.quote)) if params else "")
    data = json.dumps(body).encode("utf-8") if body is not None else None
    hdr = {"Authorization": oauth_header(method, url, *k, params=params), "User-Agent": "nr-xjukebox/1"}
    if data is not None:
        hdr["Content-Type"] = "application/json"
    req = urllib.request.Request(full, data=data, method=method, headers=hdr)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status, {k2.lower(): v for k2, v in r.headers.items()}, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, {k2.lower(): v for k2, v in e.headers.items()}, e.read().decode("utf-8", "replace")[:1000]
    except Exception as e:
        return 0, {}, str(e)[:200]


