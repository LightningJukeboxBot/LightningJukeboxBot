class Bot:
    def __init__(self, xcall=None, getter=None, poster=None, notifier=None, fetcher=None):
        self.x = xcall or x_call
        self.get = getter or api_get
        self.post = poster or api_post
        self.tell = notifier or notify
        self.fetch = fetcher or fetch_json
        self.st = load_state()
        self.ledger = Ledger(P("ledger.tsv"))
        self.codes = load_json("codes.json", {})
        self.due = {}
        self.stopping = False
        self.rebuild_unconverted()

    def rebuild_unconverted(self):
        """The waiting sats are replayed from the book: unconverted rows without a conv: income row (plus state's own)."""
        conv = {r[4][5:] for r in self.ledger.rows if r[1] == "income" and r[4].startswith("conv:")}
        out = [{"code": r[4][5:], "sats": r[3], "ts": r[0]} for r in self.ledger.rows if r[1] == "unconverted" and r[4].startswith("code:") and r[4][5:] not in conv]
        have = {u["code"] for u in out}
        for u in self.st.get("unconverted") or []:
            if u.get("code") not in have and u.get("code") not in conv:
                out.append(u)
        self.st["unconverted"] = out

    # ---- small helpers
    def now(self):
        return CLOCK()

    def x_now(self):
        return self.now() + float(self.st.get("clock_offset") or 0)

    def live(self):
        return os.path.exists(P("LIVE")) and not os.path.exists(P("OFF"))

    def save(self):
        now = self.now()
        st = self.st
        st["seen"] = {k: v for k, v in st["seen"].items() if now - v < 86400}
        st["stamps"] = [t for t in st["stamps"] if now - t < 3600]
        st["authors"] = {a: v for a, v in st["authors"].items() if now - float(v.get("last") or 0) < 2 * 86400}
        st["would"] = st["would"][-200:]
        save_json("state.json", st)

    def save_codes(self):
        save_json("codes.json", self.codes)

    def alert(self, kind, text):
        """One Telegram line per kind per 6 h."""
        now = self.now()
        if now - float(self.st["alerts"].get(kind, 0)) < ALERT_GAP_S:
            return False
        self.st["alerts"][kind] = now
        log("ALERT %s: %s" % (kind, text))
        self.tell("X jukebox: " + text)
        # nr_groupping (SF 2026-09-12): money stopped -> ONE ping in the public group (the relay tags
        # @noderunnersfm @plebroyale); if still stopped after 7 days, once more with @mospleb.
        if kind in ("purse", "402"):
            if not self.st.get("stopped_since"):
                self.st["stopped_since"] = now
                self.st["group_pinged"] = True
                self.group_tell("the X lane stopped (%s). Check the bot's DM." % kind)
        return True

    def group_tell(self, text):
        """A note for the public group too (a test notifier without the group flag just gets the text)."""
        try:
            self.tell("X jukebox: " + text, group=True)
        except TypeError:
            self.tell("X jukebox: " + text)

    def stop_watch(self):
        """Still stopped after a week -> one more group ping, this time for @mospleb. Cleared when money flows."""
        since = float(self.st.get("stopped_since") or 0)
        if not since:
            return
        if self.ledger.float() > 0 and not self.st.get("dead"):
            self.st["stopped_since"] = 0; self.st["group_pinged"] = False; self.st["mospleb_pinged"] = False
            return
        if self.now() - since >= 7 * 86400 and not self.st.get("mospleb_pinged"):
            self.st["mospleb_pinged"] = True
            self.group_tell("@mospleb the X lane has been stopped for a week and nobody answered. Please poke @plebroyale or @noderunnersfm.")

    def today(self):
        d = day_of(self.now())
        t = self.st["today"]
        if t.get("day") != d:
            self.st["today"] = t = {"day": d, "posts": 0, "replies": 0, "would": 0, "paid": 0, "trips": {}}
        return t

    def book(self, kind, usd, sats, ref):
        """Ledger-first. Returns True when the line is on disk (fsync'd); False = the call it books must NOT happen."""
        try:
            self.ledger.append(kind, usd, sats, ref)
            return True
        except Exception as e:
            log("BOOK FAILED (%s %.4f %s): %s -- the call is not made" % (kind, usd, ref, e))
            self.alert("ledger", "the ledger cannot be written (%s). The lane is quiet until it can." % str(e)[:80])
            return False

    def spend_today(self):
        return self.ledger.spend(day_start(self.now()))

    def spend_month(self):
        return self.ledger.spend(month_start(self.now()))

    def daily_cap(self):
        return read_float_file("budget-usd-per-day", 0.0) or 0.0

    def console_cap(self):
        return read_float_file("console-cap-usd", DEFAULT_CONSOLE_CAP) or DEFAULT_CONSOLE_CAP

    def announcer_estimate(self):
        a = self.st["ann"]
        if a.get("month") != month_of(self.now()):
            return 0.0
        return round(int(a.get("n") or 0) * prices()["post"], 6)

    def month_to_date(self):
        return round(self.spend_month() + self.announcer_estimate(), 6)

    def can_spend(self, usd, what):
        """The purse, the daily limit and the console wall, before any booking. Returns a reason or ''."""
        if self.ledger.float() < usd - 1e-9:
            self.alert("purse", "the purse is empty (float $%.3f, next %s costs $%.3f). Earned this month $%.2f, spent $%.2f. Quiet until seed-usd is raised." % (
                self.ledger.float(), what, usd, self.earned_month(), self.spend_month()))
            return "purse"
        cap = self.daily_cap()
        if cap <= 0:
            self.alert("nocap", "budget-usd-per-day is missing or 0 -- the lane stays quiet.")
            return "daily-cap"
        if self.spend_today() + usd > cap + 1e-9:
            if self.st.get("cap_told") != day_of(self.now()):
                self.st["cap_told"] = day_of(self.now())
                self.st["alerts"].pop("cap", None)
                self.alert("cap", "the daily limit ($%.2f) is reached: spent $%.3f today. Quiet until 00:00 UTC." % (cap, self.spend_today()))
            return "daily-cap"
        wall = CONSOLE_WALL * self.console_cap()
        if self.month_to_date() + usd > wall:
            if self.st.get("console_told") != month_of(self.now()):
                self.st["console_told"] = month_of(self.now())
                self.alert("console", "month-to-date spend $%.2f (this bot $%.2f + announcer est. $%.2f) reached 70 %% of the $%.0f console cap. Quiet until next month." % (
                    self.month_to_date(), self.spend_month(), self.announcer_estimate(), self.console_cap()))
            return "console"
        return ""

    def earned_month(self):
        return round(sum(r[2] for r in self.ledger.rows if r[0] >= month_start(self.now()) and r[1] == "income"), 6)

    # ---- the seed file -> the book
    def seed_sync(self):
        v = read_float_file("seed-usd")
        if v is None:
            return
        v = round(v, 2)
        rows = [r for r in self.ledger.rows if r[1] in ("seed", "topup")]
        seen = round(sum(r[2] for r in rows), 6) if rows else None       # the column, never one line's ref
        if seen is not None and abs(seen - v) < 0.005:
            return
        delta = round(v - (seen or 0.0), 2)
        kind = "seed" if seen is None else "topup"
        if self.book(kind, delta, 0, "seed-usd=%.2f" % v):
            log("%s booked: %+.2f USD (seed-usd now %.2f; float %.3f)" % (kind, delta, v, self.ledger.float()))

    # ---- the rate rule
    def fetch_rates(self):
        now = self.now()
        if now - float(self.st.get("rate_checked") or 0) < RATE_EVERY_S:
            return
        self.st["rate_checked"] = now
        rates = self.st.setdefault("rates", {})
        try:
            d = self.fetch(RATE_A)
            rates["coinbase"] = {"usd": float(d["data"]["amount"]), "ts": now}
        except Exception as e:
            log("coinbase rate not read: %s" % str(e)[:80])
        try:
            d = self.fetch(RATE_B)
            res = d["result"]
            rates["kraken"] = {"usd": float(res[next(iter(res))]["c"][0]), "ts": now}
        except Exception as e:
            log("kraken rate not read: %s" % str(e)[:80])

    def rate_usd(self):
        """Two sources fresh within 24 h, agreeing within 10 %, the LOWER wins minus 10 %; an outlier (more than 15 % from
        the last accepted, when that is under 72 h old) is rejected with a Telegram line. None = no valid rate."""
        now = self.now()
        rs = self.st.get("rates") or {}
        vals = [float(r["usd"]) for k in ("coinbase", "kraken") for r in [rs.get(k)] if r and now - float(r["ts"]) < RATE_FRESH_S and float(r["usd"]) > 0]
        if len(vals) < 2:
            return None
        a, b = vals
        if abs(a - b) / max(a, b) > RATE_AGREE:
            self.alert("rate-disagree", "the two BTC price sources disagree by more than 10 %% (%.0f vs %.0f). Sats wait as sats." % (a, b))
            return None
        r = min(a, b) * (1 - RATE_HAIRCUT)
        acc = self.st.get("rate_accepted") or {}
        if acc.get("usd") and now - float(acc.get("ts") or 0) < RATE_OUTLIER_REF_S and abs(r - float(acc["usd"])) / float(acc["usd"]) > RATE_OUTLIER:
            self.alert("rate-outlier", "BTC rate %.0f rejected: more than 15 %% from the last accepted %.0f. Sats wait as sats." % (r, float(acc["usd"])))
            return None
        self.st["rate_accepted"] = {"usd": round(r, 2), "ts": now, "coinbase": a, "kraken": b}
        return r

    def rate_ref(self):
        acc = self.st.get("rate_accepted") or {}
        return "coinbase=%.2f;kraken=%.2f;used=%.2f" % (acc.get("coinbase", 0), acc.get("kraken", 0), acc.get("usd", 0))

    def convert_pending(self):
        if not self.st.get("unconverted"):
            return
        rate = self.rate_usd()
        if rate is None:
            return
        keep = []
        for u in list(self.st["unconverted"]):
            usd = round(int(u["sats"]) / 1e8 * rate, 6)
            if self.book("rate", 0, 0, self.rate_ref()) and self.book("income", usd, int(u["sats"]), "conv:%s" % u["code"]):
                log("converted %d sats of code %s to $%.4f" % (int(u["sats"]), u["code"], usd))
            else:
                keep.append(u)
        self.st["unconverted"] = keep

    # ---- the song price of the day
    def unpaid_per_paid(self):
        since = self.now() - 30 * 86400
        replies = self.ledger.count(("reply",), since, "code:")
        paid = self.ledger.count(("income", "unconverted"), since, "code:")
        if paid < UNPAID_MIN_PAID:
            return UNPAID_DEFAULT
        return max(0.0, replies - paid) / float(paid)

    def price_file(self):
        t = read_text("price-sats")
        if t is None:
            return None
        try:
            v = int(float(t.strip()))
            return v if 21 <= v <= 100000 else None
        except ValueError:
            return None

    def current_price(self):
        v = self.price_file()
        if v:
            return v
        return int(self.st["price"].get("sats") or 0) or DEFAULT_PRICE

    def price_daily(self):
        today = day_of(self.now())
        if self.st["price"].get("day") == today:
            return
        rate = self.rate_usd()
        if rate is None:
            return
        sats = compute_price(prices(), rate, self.unpaid_per_paid())
        self.st["price"].update({"day": today, "sats": sats, "computed_at": self.now(), "unpaid": round(self.unpaid_per_paid(), 3)})
        path = P("price-sats")
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            mtime = None
        written = float(self.st["price"].get("written_at") or 0)
        hand = mtime is not None and (written == 0 or mtime > written + 1)
        if hand:
            self.st["price"]["hand"] = True
            log("price of the day computed at %d sats; price-sats is set by hand (%s) and stays" % (sats, (read_text("price-sats") or "").strip()))
            return
        write_text("price-sats", "%d\n" % sats)
        self.st["price"]["written_at"] = os.path.getmtime(path)
        self.st["price"]["hand"] = False
        log("price of the day: %d sats (rate %.0f, unpaid per paid %.2f)" % (sats, rate, self.unpaid_per_paid()))

    # ---- X, wrapped: the clock offset and the error classes
    def xreq(self, method, path, params=None, body=None):
        code, hdrs, text = self.x(method, path, params, body)
        d = hdrs.get("date") if hdrs else None
        if d:
            try:
                off = round(email.utils.parsedate_to_datetime(d).timestamp() - self.now(), 1)
                if abs(off) > 600:
                    self.alert("clock", "X's clock is %.0f s away from this box; the offset is ignored (the last good one stays). Check the box's clock." % off)
                else:
                    self.st["clock_offset"] = off
            except Exception:
                pass
        return code, hdrs, text

    def x_error(self, code, hdrs, text, what):
        """The common X error handling. Returns the reason string."""
        now = self.now()
        low = (text or "").lower()
        if code == 401:
            self.st["dead"] = "401"
            self.alert("401", "X REJECTED the keys (401) on %s. Stopped until the keys are fixed and the service restarted." % what)
            return "401"
        if code == 402:
            self.st["dead"] = "402"
            self.alert("402", "X says PAYMENT REQUIRED (402): the credits are used up. Stopped until restarted (load credits first).")
            return "402"
        if code == 403:
            if what == "reply" and ("duplicate" in low):
                return "duplicate"
            counts = not any(w in low for w in ("deleted", "not found", "no longer", "blocked", "does not exist"))
            if what != "reply":
                self.st["backoff_until"] = now + 1800
                self.alert("403", "X refused a %s (403): %s -- back off 30 min. Check the app's permissions." % (what, text[:160]))
                return "403"
            if counts:
                self.st["refusals"] = int(self.st.get("refusals") or 0) + 1
                if self.st["refusals"] >= 3:
                    self.st["refusals"] = 0
                    self.st["backoff_until"] = now + 1800
                    self.alert("403", "X refused 3 replies in a row (last: %s). The lane pauses 30 min." % text[:160])
                    return "403-streak"
                return "403"
            return "403-nocount"
        if code == 429:
            try:
                reset = float(hdrs.get("x-rate-limit-reset") or 0)
            except ValueError:
                reset = 0
            until = reset if now + 5 <= reset <= now + 3600 else now + 900
            self.st["backoff_until"] = until
            log("X rate limit (429) on %s: sleeping until %s" % (what, time.strftime("%H:%M:%SZ", time.gmtime(until))))
            return "429"
        self.st["backoff_until"] = now + 120
        log("X %s failed (%s %s): back off 2 min" % (what, code, (text or "")[:100]))
        return "error %s" % code

    def x_me(self):
        """The bot's own user id, once (one billed read, booked as a user read), cached in state."""
        if self.st.get("user_id"):
            return "ok"
        p = prices()
        why = self.can_spend(p["user"], "users/me")
        if why:
            return why
        if not self.book("read", -p["user"], 0, "users/me"):
            return "ledger-failed"
        code, hdrs, text = self.xreq("GET", "/2/users/me")
        if code != 200:
            self.book("read_adjust", p["user"], 0, "users/me:error")
            return self.x_error(code, hdrs, text, "users/me")
        try:
            d = json.loads(text)["data"]
            uid, uname = str(d["id"]), str(d.get("username") or "")
        except Exception:
            self.st["backoff_until"] = self.now() + 120
            return "error me-body"
        if uname and uname.casefold() != BOT_HANDLE.casefold():
            self.st["dead"] = "wrong account"
            self.alert("account", "the X keys belong to @%s, not @%s. Stopped." % (uname, BOT_HANDLE))
            return "wrong-account"
        self.st["user_id"] = uid
        log("I am @%s (id %s)" % (uname or "?", uid))
        return "ok"

    # ---- one poll of the mentions
    def cycle(self):
        """One poll: the gates, the booking, the call, the correction, then every post in order. Returns a reason."""
        now = self.now()
        if os.path.exists(P("OFF")):
            return "off"
        self.stop_watch()
        if self.st.get("dead"):
            return "dead"
        if now < float(self.st.get("backoff_until") or 0):
            return "backoff"
        self.seed_sync()
        if not keys():
            self.st["dead"] = "no keys"
            self.alert("keys", "the four X keys are missing (x.env). Stopped.")
            return "no-keys"
        r = self.x_me()
        if r != "ok":
            return r
        p = prices()
        cost = MAX_RESULTS * p["read"]
        why = self.can_spend(cost, "a poll")
        if why:
            return why
        if not self.st.get("since_id"):
            self.st["since_id"] = str(snowflake(self.x_now()))
            log("first start: since_id = now (%s); the backlog is never read" % self.st["since_id"])
            self.save()
        if not self.book("read", -cost, 0, "poll"):
            return "ledger-failed"
        params = {"since_id": self.st["since_id"], "max_results": str(MAX_RESULTS),
                  "tweet.fields": "author_id,created_at,in_reply_to_user_id,referenced_tweets,entities,edit_history_tweet_ids,note_tweet,reply_settings"}
        code, hdrs, text = self.xreq("GET", "/2/users/%s/mentions" % self.st["user_id"], params)
        if code != 200:
            self.book("read_adjust", cost, 0, "poll:error")
            return self.x_error(code, hdrs, text, "poll")
        try:
            d = json.loads(text)
            posts = d.get("data") or []
            meta = d.get("meta") or {}
            if not isinstance(posts, list):
                raise ValueError("data is not a list")
        except Exception:
            self.st["backoff_until"] = self.now() + 120
            log("poll: unreadable answer from X; the booked reads stay booked; back off 2 min")
            return "error body"
        n = len(posts)
        if n < MAX_RESULTS:
            self.book("read_adjust", (MAX_RESULTS - n) * p["read"], 0, "poll:%d" % n)
        self.today()["posts"] += n
        if n:
            newest = str(meta.get("newest_id") or max(int(x.get("id") or 0) for x in posts))
            if int(newest) > int(self.st["since_id"]):
                self.st["since_id"] = newest
        reasons = []
        for post in sorted(posts, key=lambda x: int(x.get("id") or 0)):
            try:
                reasons.append(self.handle_post(post))
            except Exception as e:
                log("post %s: error %s" % (post.get("id"), e))
                reasons.append("error")
            if self.stopping:
                pass                                        # the cycle in hand is always finished
        return "polled %d: %s" % (n, ",".join(reasons)) if n else "empty"

    # ---- the checks of charter section 4, in order
    def author(self, a):
        rec = self.st["authors"].setdefault(a, {})
        d = day_of(self.now())
        if rec.get("day") != d:
            rec.update({"day": d, "n": 0, "trips": 0})
        return rec

    def trip(self, a, why):
        rec = self.author(a)
        rec["trips"] = int(rec.get("trips") or 0) + 1
        self.today()["trips"][a] = rec["trips"]
        if rec["trips"] >= TRIPS_TO_IGNORE and not self.ignored(a):
            until = self.now() + IGNORE_S
            try:
                with open(P("ignore.txt"), "a", encoding="utf-8", newline="\n") as fh:
                    fh.write("%s\t%d\t%s\n" % (a, until, day_of(until)))
            except OSError as e:
                log("could not write ignore.txt: %s" % e)
            log("author %s ignored for a week after %d trips today (last: %s)" % (a, rec["trips"], why))

    def ignored(self, a):
        now = self.now()
        for line in (read_text("ignore.txt") or "").splitlines():
            f = line.split("\t")
            if f and f[0] == a and len(f) > 1:
                try:
                    if float(f[1]) > now:
                        return True
                except ValueError:
                    pass
        return False

    def opted_out(self, a):
        return a in (read_text("optout.txt") or "").split()

    def open_code_for(self, a):
        now = self.now()
        return any(c.get("author") == a and c.get("status") in ("open", "minted") and float(c.get("expires_at") or 0) > now
                   for c in self.codes.values())

    def handle_post(self, post):
        now = self.now()
        pid = str(post.get("id") or "")
        author = str(post.get("author_id") or "")
        text = str(post.get("text") or "")
        if not pid or not author:
            return "malformed"
        refs = [str(r.get("type")) for r in (post.get("referenced_tweets") or []) if isinstance(r, dict)]
        if "retweeted" in refs:
            return "retweet"
        if "quoted" in refs:
            return "quote"
        if post.get("note_tweet"):
            return "long"
        if self.opted_out(author):
            return "optedout"
        if is_optout(text):
            with open(P("optout.txt"), "a", encoding="utf-8", newline="\n") as fh:
                fh.write(author + "\n")
            log("opt-out from author %s: never answered again" % author)
            return "optout"
        parsed = parse_play(text)
        if not parsed:
            return "not-for-bot"
        ments = [m for m in ((post.get("entities") or {}).get("mentions") or []) if isinstance(m, dict)]
        me = self.st.get("user_id") or ""
        lead = _LEAD.match(text)
        lead_end = lead.end() if lead else 0          # names X put in front (thread participants) are not the listener's friends
        others, exclude, summoned = [], [], False
        for m in ments:
            mid, mu = str(m.get("id") or ""), str(m.get("username") or "")
            try:
                start = int(m.get("start") or 0)
            except (TypeError, ValueError):
                start = 0
            if (mid and mid == me) or mu.casefold() == BOT_HANDLE.casefold():
                summoned = True
            elif mid and mid != author:
                if mid not in exclude:
                    exclude.append(mid)                  # nobody the listener's post names is ever tagged by the bot
                if start >= lead_end and mid not in others:
                    others.append(mid)
        if not summoned:
            return "not-summoned"
        if len(others) > 1:
            return "second-friend"
        rs = str(post.get("reply_settings") or "everyone")
        if rs not in ("everyone", "mentionedUsers"):
            return "reply-restricted"                    # X would refuse the reply (403): no mint, no count, no streak
        created = parse_created(post.get("created_at"))
        if created is None:
            return "no-time"
        age = self.x_now() - created
        if age > MAX_AGE_S:
            self.today()["old"] = int(self.today().get("old") or 0) + 1
            return "old"
        if age < -MAX_FUTURE_S:
            return "future"
        eh = post.get("edit_history_tweet_ids") or [pid]
        key = str(eh[0])
        if key != pid:
            return "edited"
        if key in self.st["seen"]:
            return "seen"
        self.st["seen"][key] = now
        if self.ignored(author):
            return "ignored"
        rec = self.author(author)
        last = float(rec.get("last") or 0)
        rec["last"] = now
        if now - last < AUTHOR_COOLDOWN_S:
            self.trip(author, "cooldown")
            return "cooldown"
        if self.open_code_for(author):
            self.trip(author, "open-code")
            return "open-code"
        if int(rec.get("n") or 0) >= PER_AUTHOR_DAY:
            self.trip(author, "author-cap")
            return "author-cap"
        _k, q_raw, msg_raw = parsed
        if not q_raw:
            return "no-query"
        q = ann.clean(q_raw, QUERY_MAX)
        note = ann.clean(msg_raw, NOTE_MAX)
        bl = ann.load_blocklist()
        if (q and ann.blocked(q, bl)) or (note and ann.blocked(note, bl)):
            self.trip(author, "blocklist")
            log("blocklist hit from author %s: silence" % author)
            return "blocked"
        if len([t for t in self.st["stamps"] if now - t < 3600]) >= MAX_PER_HOUR:
            if now - float(self.st.get("hour_cap_told") or 0) > 3600:
                self.st["hour_cap_told"] = now
                self.alert("hour", "%d replies in an hour -- quiet until the hour passes." % MAX_PER_HOUR)
            return "hour-cap"
        if not self.live():
            rec["n"] = int(rec.get("n") or 0) + 1
            self.st["stamps"].append(now)
            self.today()["would"] += 1
            self.st["would"].append({"ts": now, "post": pid, "author": author, "q": q, "note": note, "friend": others[:1], "exclude": exclude})
            log("[practice] would reply to post %s (author %s): q=%r note=%r friend=%s" % (pid, author, q, note, others[:1]))
            return "would-reply"
        p = prices()
        why = self.can_spend(p["reply"], "a reply")
        if why:
            return why
        if not q:
            return self.send(pid, author, exclude, compose_nomatch(""), "nomatch", None, note)
        sats = self.current_price()
        probe = compose_reply(SITE + "/?jukebox&p=" + "x" * 8, sats, sats + 210)
        if weighted(probe) > 280:
            self.alert("template", "the reply template runs over 280 -- nothing is minted.")
            return "too-long"
        code, body = self.post("/api/x/code", {"q": q, "sats": str(sats), "note": note})
        if code == 409:
            self.st["station_down_since"] = 0
            if not self.st.get("sesh_since"):
                self.st["sesh_since"] = now
            if float(rec.get("sesh") or 0) >= float(self.st["sesh_since"]):
                return "sesh-quiet"
            rec["sesh"] = now
            name = ann.clean(body.get("dj") or body.get("name") or "", 24) or "the crew"
            return self.send(pid, author, exclude, compose_sesh(name), "sesh", None, note)
        if code == 400:
            self.st["station_down_since"] = 0
            err = str(body.get("error") or "")
            if "missing q" in err:
                return self.send(pid, author, exclude, compose_nomatch(q), "nomatch", None, note)
            self.alert("config", "the station refused a code (400: %s). Check price-sats (%d)." % (err[:100], sats))
            return "config"
        if code != 200 or not body.get("code") or not body.get("url"):
            if not self.st.get("station_down_since"):
                self.st["station_down_since"] = now
            elif now - float(self.st["station_down_since"]) > STATION_DOWN_ALERT_S:
                self.alert("station", "the station has not minted a code for 6 hours (last: HTTP %s %s)." % (code, str(body)[:80]))
            log("station did not mint (HTTP %s %s): no code, no reply" % (code, str(body)[:100]))
            return "station-down"
        self.st["station_down_since"] = 0
        self.st["sesh_since"] = 0
        xc = str(body["code"])
        url = str(body["url"])
        sats_m = int(body.get("sats") or sats)
        wl = int(body.get("wl_sats") or sats_m + 210)
        self.codes[xc] = {"author": author, "sats": sats_m, "wl_sats": wl, "minted_ts": now,
                          "expires_at": now + int(body.get("expires_in") or CODE_LIFE_S), "status": "open", "post": pid, "q": q}
        self.save_codes()
        return self.send(pid, author, exclude, compose_reply(url, sats_m, wl), "code", xc, note)

    def send(self, pid, author, exclude, text, kind, xc, note=""):
        """In-flight to disk, the reply in the book, THEN the POST, THEN 'sent'. Never a second reply for this post."""
        now = self.now()
        rec = self.author(author)
        ref = ("code:%s" % xc) if xc else kind
        self.st["inflight"][pid] = {"code": xc or "", "author": author, "kind": kind, "ts": now, "day_n": int(rec.get("n") or 0) + 1}
        try:
            self.save()
        except Exception as e:
            log("could not write the in-flight record: %s -- no reply" % e)
            self.st["inflight"].pop(pid, None)
            return "state-failed"
        if not self.book("reply", -prices()["reply"], 0, ref):
            self.st["inflight"].pop(pid, None)
            if xc:
                self.tell("X jukebox: code %s was minted but the reply was not sent (the ledger cannot be written)." % xc)
            return "booking-failed"
        if weighted(text) > 280:
            self.st["inflight"].pop(pid, None)
            return "too-long"
        body = {"text": text, "reply": {"in_reply_to_tweet_id": pid}}
        if exclude:
            body["reply"]["exclude_reply_user_ids"] = list(exclude)
        bal_before = None                               # charter section 3: the real balance around the first reply of the day
        if self.st.get("balance_day") != day_of(now) and os.path.exists(P("balance-check")):
            self.st["balance_day"] = day_of(now)
            bal_before = self.balance_check("before the first reply of the day")
        code, hdrs, resp = self.xreq("POST", "/2/tweets", None, body)
        self.st["inflight"].pop(pid, None)
        if code in (200, 201):
            rec["n"] = int(rec.get("n") or 0) + 1        # counted only when X took the reply (a refusal burns nothing)
            self.st["stamps"].append(now)
            self.st["refusals"] = 0
            self.today()["replies"] += 1
            try:
                rid = json.loads(resp).get("data", {}).get("id", "?")
            except Exception:
                rid = "?"
            log("replied %s to post %s (%s%s): %s" % (rid, pid, kind, (" " + xc) if xc else "", text.replace("\n", " / ")))
            if bal_before is not None:
                after = self.balance_check("after the first reply of the day")
                if after is not None:
                    taken, expect = bal_before - after, prices()["reply"]
                    log("balance check: X took $%.4f for the reply; the book expected $%.4f" % (taken, expect))
                    if taken > 3 * expect:
                        self.st["dead"] = "balance"
                        self.alert("balance", "X took $%.4f for one reply, more than 3x the booked $%.4f. Stopped until restarted; check prices.json." % (taken, expect))
            self.save()
            return "replied"
        r = self.x_error(code, hdrs, resp, "reply")
        log("reply to post %s NOT sent (HTTP %s %s): %s" % (pid, code, r, resp[:160]))
        if xc:
            self.alert("minted-unsent", "code %s was minted but the reply was not sent (HTTP %s: %s). The post is not retried." % (xc, code, resp[:120]))
        self.save()
        return "reply-failed"

    # ---- the code watcher and the announcer count
    def watch(self):
        now = self.now()
        changed = False
        for xc, c in list(self.codes.items()):
            if c.get("status") == "paid":
                if now - float(c.get("paid_ts") or now) > 86400:
                    self.codes.pop(xc)
                    changed = True
                continue
            if now > float(c.get("minted_ts") or 0) + PAID_WINDOW_S:
                self.codes.pop(xc)
                changed = True
                continue
            if now < float(c.get("expires_at") or 0) + 120 or c.get("status") == "open":
                code, body = self.get("/api/x/code", c=xc)
                if code == 200:
                    if body.get("status") == "minted" and c.get("status") != "minted":
                        c.update({"status": "minted", "artist": body.get("artist") or "", "title": body.get("title") or ""})
                        changed = True
                        if self.st.get("sesh_since"):
                            self.st["sesh_since"] = 0        # a mint went through at the station: the sesh is over
                elif code == 404 and c.get("status") == "open":
                    c["status"] = "dead"
                    changed = True
        code, body = self.get("/api/nowplaying")
        if code == 200:
            changed = self.scan_nowplaying(body) or changed
            changed = self.quote_onair(body) or changed      # nr_xquote: after the credit, never before it
        if changed:
            self.save_codes()
        return changed

    def scan_nowplaying(self, body):
        """A paid request on air or in the queue: ours (a minted code's song, requested via X) -> income; else the
        announcer's post is counted for the console wall."""
        now = self.now()
        a = self.st["ann"]
        if a.get("month") != month_of(now):
            a.update({"month": month_of(now), "n": 0})
        a["seen"] = {k: v for k, v in (a.get("seen") or {}).items() if now - v < 86400}
        changed = False
        items = [body.get("now_playing")] + list(body.get("queue") or [])
        for t in items:
            if not isinstance(t, dict) or not t.get("requested") or not t.get("req_id"):
                continue
            rid = str(t["req_id"])
            if rid in a["seen"]:
                continue
            a["seen"][rid] = now
            via, who = str(t.get("note_via") or ""), str(t.get("who") or "")
            ours = None
            if via == "x" and who == "an X listener":          # strictly the X lane's own stamp
                key = ((t.get("artist") or "").casefold(), (t.get("title") or "").casefold())
                hits = [(int(c.get("sats") or 0), float(c.get("minted_ts") or 0), xc) for xc, c in self.codes.items()
                        if c.get("status") == "minted" and ((c.get("artist") or "").casefold(), (c.get("title") or "").casefold()) == key]
                if hits:
                    hits.sort()
                    ours = hits[0][2]                            # the LOWEST sats when more than one code holds the song
                    if len(hits) > 1:
                        log("ambiguous: %d minted codes hold %s - %s; crediting the lowest (%s, %d sats)" % (len(hits), t.get("artist"), t.get("title"), ours, hits[0][0]))
            if ours is None:
                a["n"] = int(a.get("n") or 0) + 1
                continue
            c = self.codes[ours]
            if self.ledger.count(("income", "unconverted"), 0, "code:%s" % ours):
                log("code %s is already in the book as paid; not booked twice" % ours)
                c.update({"status": "paid", "paid_ts": now, "req_id": rid})
                changed = True
                continue
            p = prices()
            self.book("onair", -p["post"], 0, "code:%s" % ours)
            sats = int(c.get("sats") or 0)
            rate = self.rate_usd()
            booked = False
            if rate is not None:
                usd = round(sats / 1e8 * rate, 6)
                booked = self.book("rate", 0, 0, self.rate_ref()) and self.book("income", usd, sats, "code:%s" % ours)
                if booked:
                    log("PAID: code %s -> %s - %s, %d sats = $%.4f (float %.3f)" % (ours, t.get("artist"), t.get("title"), sats, usd, self.ledger.float()))
            if not booked:
                self.book("unconverted", 0, sats, "code:%s" % ours)
                self.st["unconverted"].append({"code": ours, "sats": sats, "ts": now})   # state keeps it even if that line failed too
                log("PAID: code %s -> %s - %s, %d sats wait in the book as sats" % (ours, t.get("artist"), t.get("title"), sats))
            c.update({"status": "paid", "paid_ts": now, "req_id": rid})
            self.today()["paid"] += 1
            changed = True
        return changed

    # ---- nr_xquote (SF 2026-09-13): the on-air post is a quote post of the listener's own request
    def quote_onair(self, body):
        """The song a listener paid for through X is NOW PLAYING: quote their original post, once.
        The cost was booked as "onair" when scan_nowplaying credited the song, so nothing more is booked here."""
        np = body.get("now_playing") if isinstance(body, dict) else None
        if not isinstance(np, dict) or not np.get("requested") or not np.get("req_id"):
            return False
        rid = str(np["req_id"])
        hits = [xc for xc, c in self.codes.items()
                if c.get("status") == "paid" and str(c.get("req_id") or "") == rid and not c.get("quoted")]
        if not hits:
            return False
        xc = hits[0]
        c = self.codes[xc]
        src = str(c.get("post") or "")
        if not src:
            c["quoted"] = "no-source"
            return True
        text = compose_onair(np.get("artist") or c.get("artist") or "", np.get("title") or c.get("title") or "",
                             np.get("note") or "", ann.load_blocklist())
        if not text or weighted(text) > 280:
            c["quoted"] = "nothing-to-say"
            log("code %s on air, but there is nothing to say; no quote post" % xc)
            return True
        if not self.live():
            c["quoted"] = "practice"
            log("[practice] would quote post %s (code %s): %s" % (src, xc, text))
            return True
        if self.st.get("dead") or self.now() < float(self.st.get("backoff_until") or 0):
            return False                                   # tried again next minute, while the song is still on air
        c["quoted"] = "inflight"                           # on disk BEFORE the call: a crash never posts twice
        try:
            self.save_codes()
        except Exception as e:
            c.pop("quoted", None)
            log("could not write codes.json before the quote post (%s) -- not posted" % e)
            return False
        code, hdrs, resp = self.xreq("POST", "/2/tweets", None, {"text": text, "quote_tweet_id": src})
        if code in (200, 201):
            c["quoted"] = "posted"
            try:
                qid = json.loads(resp).get("data", {}).get("id", "?")
            except Exception:
                qid = "?"
            c["quote_id"] = qid
            log("quoted %s -> %s (code %s): %s" % (src, qid, xc, text))
            if "\u201c" in text:
                self.tell("X jukebox: quote post %s carried a shoutout. Delete it on X if it must go: %s" % (qid, text))
            return True
        low = (resp or "").lower()
        if code in (400, 403, 404) and any(w in low for w in ("deleted", "not found", "no longer", "does not exist",
                                                               "unavailable", "not allowed", "cannot quote")):
            c["quoted"] = "source-gone"
            log("the listener's post %s cannot be quoted (HTTP %s: %s) -- not retried" % (src, code, resp[:160]))
            return True
        c["quoted"] = "failed"
        r = self.x_error(code, hdrs, resp, "quote post")
        log("quote post for code %s NOT sent (HTTP %s %s): %s" % (xc, code, r, (resp or "")[:160]))
        return True

    # ---- the daily line and the balance check
    def daily_line(self):
        now = self.now()
        d = day_of(now)
        if self.st.get("daily_line") == d or time.gmtime(now).tm_hour < DAILY_LINE_H:
            return False
        self.st["daily_line"] = d
        t = self.today()
        acc = self.st.get("rate_accepted") or {}
        age = ("%.0f h" % ((now - float(acc["ts"])) / 3600)) if acc.get("ts") else "-"
        offenders = [a for a, n in (t.get("trips") or {}).items() if n >= TRIPS_TO_IGNORE]
        line = ("day %s: %d posts read (%d too old), %d replies, %d would-reply, %d paid songs; spent today $%.3f, this month $%.2f "
                "(+$%.2f for %d announcer posts seen by this bot); float $%.3f; price %d sats%s; rate $%s (%s old); %s; repeat offenders: %s" % (
                    d, t["posts"], int(t.get("old") or 0), t["replies"], t["would"], t["paid"], self.spend_today(), self.spend_month(), self.announcer_estimate(),
                    int(self.st["ann"].get("n") or 0) if self.st["ann"].get("month") == month_of(now) else 0,
                    self.ledger.float(), self.current_price(), " (by hand)" if self.st["price"].get("hand") else "",
                    ("%.0f" % float(acc["usd"])) if acc.get("usd") else "none", age, "LIVE" if self.live() else "practice",
                    ", ".join(offenders) or "none"))
        log("daily line: " + line)
        self.tell("X jukebox " + line)
        return True

    def balance_check(self, when):
        """Behind the balance-check file. GET /2/usage/credits is UNVERIFIED for pay-per-use: tolerant of 404, logged."""
        if not os.path.exists(P("balance-check")):
            return None
        pu = prices()["user"]
        if not self.book("read", -pu, 0, "usage/credits"):
            return None
        code, hdrs, text = self.xreq("GET", "/2/usage/credits")
        if code == 404:
            self.book("read_adjust", pu, 0, "usage/credits:404")
        log("balance check (%s): HTTP %s %s" % (when, code, (text or "")[:300].replace("\n", " ")))
        val = None
        if code == 200:
            try:
                d = json.loads(text)
                flat = d.get("data", d) if isinstance(d, dict) else {}
                for k, v in (flat.items() if isinstance(flat, dict) else []):
                    if isinstance(v, (int, float)) and any(w in k.lower() for w in ("balance", "credit", "remaining", "available")):
                        val = float(v)
                        break
            except Exception:
                pass
        self.st["credits"] = {"ts": self.now(), "http": code, "value": val, "when": when, "body": (text or "")[:300]}
        return val

    # ---- the service tick
    def tick(self):
        now = self.now()
        out = []
        if os.path.exists(P("OFF")):
            return "off"
        if now >= self.due.get("rates", 0):
            self.due["rates"] = now + 60
            self.fetch_rates()
            self.convert_pending()
            self.price_daily()
        if now >= self.due.get("poll", 0):
            self.due["poll"] = now + POLL_S
            r = self.cycle()
            out.append(r)
            if r not in ("backoff", "dead", "off", "empty"):
                self.save()
        if now >= self.due.get("watch", 0):
            self.due["watch"] = now + WATCH_S
            try:
                if self.watch():
                    self.save()
            except Exception as e:
                log("watch error: %s" % e)
        if self.daily_line():
            self.save()
        return ",".join(out) or "idle"

    def on_start(self):
        """A restart means 'try again now'; a reply that was in flight at the last stop is never sent again."""
        self.st["dead"] = ""
        self.st["backoff_until"] = 0
        for pid, rec in list(self.st["inflight"].items()):
            self.st["seen"][pid] = self.now()
            log("a reply to post %s (%s %s) was in flight at the last stop: NOT resent" % (pid, rec.get("kind"), rec.get("code") or ""))
            if rec.get("code"):
                self.tell("X jukebox: at the last stop a reply for code %s was in flight; it is not resent." % rec["code"])
        self.st["inflight"] = {}
        if self.ledger.bad:
            self.alert("ledger", "%d damaged line(s) in ledger.tsv were skipped on start; the float may be off." % self.ledger.bad)


ONAIR_HEAD = "Now playing on NoderunnersRadio.com\U0001F3A7 "     # SF's wording, 2026-09-13


def compose_onair(artist, title, note, blocklist=()):
    """The quote post's text: 'Now playing on NoderunnersRadio.com🎧 Artist — Title.' and, when the listener left one,
    ' With shoutout: “…”'. The announcer's clean() and word list, so one set of rules everywhere. None = nothing to say."""
    a0 = ann.clean(artist, 80, tracknum=True)
    t0 = ann.clean(title, 120, tracknum=True)
    if t0.casefold() == "unknown track":
        t0 = ""
    if not a0 and not t0:
        return None
    n0 = ann.clean(note, 80)
    if n0 and blocklist and ann.blocked(n0, blocklist):
        log("shoutout withheld (blocklist): " + n0)
        n0 = ""

    def build(a, t, n):
        song = "%s \u2014 %s" % (a, t) if a and t else (a or t)
        s = ONAIR_HEAD + song + ("" if song[-1:] in ".!?\u2026" else ".")
        if n:
            s += " With shoutout: \u201c%s\u201d" % n
        return s

    def cut(x, keep):
        return x if keep >= len(x) else x[:keep].rstrip() + "\u2026"

    note, keep_n, keep_t, keep_a = n0, len(n0), len(t0), len(a0)
    text = build(a0, t0, note)
    while weighted(text) > 280 and keep_n > 12:                 # 1. shorten the shoutout
        keep_n -= 1; note = cut(n0, keep_n); text = build(a0, t0, note)
    if weighted(text) > 280 and note:                           # 2. drop it
        note = ""; text = build(a0, t0, note)
    while weighted(text) > 280 and keep_t > 8:                  # 3. shorten the title
        keep_t -= 1; text = build(a0, cut(t0, keep_t), note)
    while weighted(text) > 280 and keep_a > 4:                  # 4. shorten the artist
        keep_a -= 1; text = build(cut(a0, keep_a), cut(t0, keep_t), note)
    return text


def compute_price(p, btc_usd, unpaid):
    """charter section 2: (owned read + reply + post + unpaid_per_paid x (owned read + reply)) x margin, in sats,
    rounded up to the next 10, never under 100, never over 500."""
    usd = (p["read_owned"] + p["reply"] + p["post"] + unpaid * (p["read_owned"] + p["reply"])) * p["margin"]
    sats = usd / float(btc_usd) * 1e8
    sats = int(math.ceil(sats / 10.0 - 1e-9) * 10)
    return max(PRICE_MIN, min(PRICE_MAX, sats))


