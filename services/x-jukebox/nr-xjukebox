        fh.write(json.dumps({"read": 0.001, "reply": 0.02, "post": "x"}))
    p = prices()
    check("prices: the file may raise, never lower", p["read"] == 0.005 and p["reply"] == 0.02 and p["post"] == 0.015)
    os.remove(P("prices.json"))
    p = prices()
