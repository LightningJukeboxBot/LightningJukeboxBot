    ann = mod
    return mod


_LEAD = re.compile(r"^(?:\s*@[A-Za-z0-9_]{1,15})+\s*")
_PLAY = re.compile(r"(?is)^play(?:\b|(?=\s))[\s:,-]*(.*)$")


def strip_lead(text):
    return _LEAD.sub("", html.unescape(str(text or ""))).strip()


def is_optout(text):
    """'stop' as a whole word, case-insensitive -- unless the text is a request (starts with play)."""
    t = strip_lead(text)
    if re.match(r"(?i)play\b", t):
        return False
    return re.search(r"(?i)\bstop\b", t) is not None


def parse_play(text):
    """('play', query, message) for a request, or None. The message is what follows the first |."""
    t = strip_lead(text)
    m = _PLAY.match(t)
    if not m:
        return None
    rest = m.group(1).strip()
    if "|" in rest:
        q, msg = rest.split("|", 1)
    else:
        q, msg = rest, ""
    return "play", q.strip(), msg.strip()


