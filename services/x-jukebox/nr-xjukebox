def main():
    args = sys.argv[1:]
    if args == ["--selftest"]:
        return selftest()
    if args not in ([], ["--once"], ["--check"]):
        print(__doc__)
        return 64
    try:
        load_announcer()
    except Exception as e:
        log("STOP: cannot load the announcer's text rules from %s: %s" % (ANN_PATH, e))
        return 3
    if args == ["--check"]:
        return check_cmd()
    os.makedirs(HOME, mode=0o700, exist_ok=True)
    try:
        globals()["_LOCK"] = take_lock(P(".lock"))
    except OSError:
        log("STOP: another nr-xjukebox is running (the service?).")
        return 65
    bot = Bot()
    bot.on_start()
    try:
        bot.save()
    except Exception as e:
        log("could not write the state file: %s" % e)
    log("watching mentions every %d s -- %s; float $%.3f; price %d sats" % (
        POLL_S, "LIVE (minting and replying)" if bot.live() else "PRACTICE (nothing is posted; touch %s to go live)" % P("LIVE"),
        bot.ledger.float(), bot.current_price()))
    signal.signal(signal.SIGTERM, _on_term)
    signal.signal(signal.SIGINT, _on_term)
    if hasattr(signal, "SIGBREAK"):
        signal.signal(signal.SIGBREAK, _on_term)
    if args == ["--once"]:
        r = bot.cycle()
        bot.watch()
        bot.save()
        print(r)
        return 0
    return serve(bot)


def serve(bot):
    global _stop
    while not _stop:
        try:
            bot.stopping = _stop
            bot.tick()
        except Exception as e:
            log("tick error: %s" % e)
        for _ in range(1):
            if _stop:
                break
            SLEEP(1)
    try:
        bot.save()
    except Exception as e:
        log("could not write the state file: %s" % e)
    log("stopping (signal); state saved")
    return 0


# ---------------------------------------------------------------- self-test: fakes only, nothing leaves the box
def selftest():
