    load_announcer()
    ann.HOME = os.path.join(d, "ann")
    os.makedirs(ann.HOME)
    with open(os.path.join(ann.HOME, "blocklist.txt"), "w", encoding="utf-8") as fh:
        fh.write("badword\nkanker*\n")
    os.environ.update({"X_API_KEY": "ck", "X_API_SECRET": "cs", "X_ACCESS_TOKEN": "at", "X_ACCESS_SECRET": "ats"})
    fails, total = [], [0]

    def check(name, cond):
