    check("the same post again: seen, no second reply", bot.handle_post(p1) == "seen" and len(posted) == 1)
    # per-author: open code, cooldown, day cap
    t0["t"] += 60
    mk("A2", "@JukeboxLNDbot play nero")
    r = run()
    check("an open code blocks a second request from the same person", r.endswith("open-code") and len(posted) == 1)
    bot.codes["code0001"]["status"] = "dead"
    t0["t"] += 5
    mk("A2", "@JukeboxLNDbot play nero")
    r = run()
    check("20 s cooldown", r.endswith("cooldown") and len(posted) == 1)
    t0["t"] += 30
    mk("A2", "@JukeboxLNDbot play nero")
    r = run()
    check("after the cooldown the person is served again", r.endswith("replied") and len(posted) == 2)
    bot.codes["code0002"]["status"] = "dead"
    t0["t"] += 30
    mk("A2", "@JukeboxLNDbot play bonobo")
    r = run()
    check("the third reply of the day", r.endswith("replied") and len(posted) == 3)
