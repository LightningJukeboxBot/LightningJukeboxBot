# ---------------------------------------------------------------- OAuth 1.0a (stdlib) -- the announcer's signer, FIXED:
# every query (and form) parameter is part of the signature base string (RFC 5849 section 3.4.1.3), not only oauth_*.
def _pct(s):
    return urllib.parse.quote(str(s), safe="-._~")


def oauth_base(method, url, params):
    pairs = sorted((_pct(k), _pct(v)) for k, v in params.items())
    norm = "&".join("%s=%s" % kv for kv in pairs)
    return "&".join([method.upper(), _pct(url), _pct(norm)])


def oauth_header(method, url, ck, cs, at, ats, params=None, nonce=None, ts=None):
    """url WITHOUT the query string; params = the query (and, for a form body, the form) parameters."""
    o = {"oauth_consumer_key": ck, "oauth_nonce": nonce or uuid.uuid4().hex, "oauth_signature_method": "HMAC-SHA1",
         "oauth_timestamp": str(ts or int(time.time())), "oauth_token": at, "oauth_version": "1.0"}
    allp = dict(params or {})
    allp.update(o)
    base = oauth_base(method, url, allp)
    key = ("%s&%s" % (_pct(cs), _pct(ats))).encode()
    o["oauth_signature"] = base64.b64encode(hmac.new(key, base.encode(), hashlib.sha1).digest()).decode()
    return "OAuth " + ", ".join('%s="%s"' % (_pct(k), _pct(o[k])) for k in sorted(o))


def keys():
    """The announcer's four X keys: from the service's EnvironmentFile, else (a shell) from the announcer's x.env."""
    names = ("X_API_KEY", "X_API_SECRET", "X_ACCESS_TOKEN", "X_ACCESS_SECRET")
    k = tuple(os.environ.get(n, "") for n in names)
    if not all(k):
        env = {}
        try:
            with open(os.path.join(ANN_HOME, "x.env"), encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if "=" in line and not line.startswith("#"):
                        n, v = line.split("=", 1)
                        env[n.strip()] = v.strip().strip('"').strip("'")
        except OSError:
            pass
        k = tuple(env.get(n, "") for n in names)
    return k if all(k) else None


# ---------------------------------------------------------------- text
_URL = re.compile(r"https?://\S+|(?<![\w/@.])[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.(?:com|net|org|io|co|nl|be|de|me|uk|xyz|fm)(?:/\S*)?", re.I)


def xlen(t):
    """X's weighted length: 1 for most Latin/Cyrillic/Greek and common punctuation, 2 for everything else (emoji, CJK, ellipsis)."""
    return sum(1 if (o <= 0x10FF or 0x2000 <= o <= 0x200D or 0x2010 <= o <= 0x201F or 0x2032 <= o <= 0x2037) else 2
               for o in map(ord, t))


def weighted(t):
    """xlen with every link counted as 23 (X wraps links in t.co)."""
    n, pos = 0, 0
    for m in _URL.finditer(t):
        n += xlen(t[pos:m.start()]) + 23
        pos = m.end()
    return n + xlen(t[pos:])


