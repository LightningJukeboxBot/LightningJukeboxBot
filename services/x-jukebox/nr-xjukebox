    check("3 trips in a day -> the ignore list for a week", bot.ignored("A2") and "A2" in (read_text("ignore.txt") or ""))
    t0["t"] += 30
    mk("A2", "@JukeboxLNDbot play once more")
    r = run()
    check("an ignored person is silence", r.endswith("ignored"))
    # the ignored checks
    t0["t"] += 60
    mk("A3", "@JukeboxLNDbot play x", friends=("77", "78"))
